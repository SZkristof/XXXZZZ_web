# Másold .env néven, és töltsd ki.
# Üres érték = az adott mérőkód egyáltalán NEM kerül az oldalra.

# --- AJÁNLOTT: Google Tag Manager -------------------------------------------
# Ha ez ki van töltve, a GA4-et, a Google Ads konverziót és a Meta Pixelt a GTM
# felületén add hozzá — így új mérőkódhoz nem kell újra deployolni az oldalt.
PUBLIC_GTM_ID=

# --- TARTALÉK: közvetlen mérőkódok ------------------------------------------
# Csak akkor használd, ha NINCS GTM konténer. GTM mellett hagyd üresen,
# különben minden konverzió kétszer számolódna.
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
