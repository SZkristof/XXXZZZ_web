---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description} noindex>
  <PageHero eyebrow="JOGI TUDNIVALÓK" title={title} />
  <section class="section-tight ground-paper">
    <div
      class="container-prose
             [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:first:mt-0
             [&_h3]:mt-8 [&_h3]:text-lg
             [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-black/80
             [&_ul]:mt-4 [&_ul]:space-y-2 [&_ul]:pl-5
             [&_li]:list-disc [&_li]:leading-relaxed [&_li]:text-black/80 [&_li]:marker:text-terracotta-800
             [&_strong]:font-semibold [&_strong]:text-black
             [&_a]:font-medium [&_a]:text-terracotta-800 [&_a]:underline [&_a]:underline-offset-2
             [&_table]:mt-5 [&_table]:w-full [&_table]:text-left [&_table]:text-sm
             [&_th]:border-b [&_th]:border-black/10 [&_th]:py-2.5 [&_th]:pr-4 [&_th]:font-semibold [&_th]:text-black
             [&_td]:border-b [&_td]:border-black/10 [&_td]:py-2.5 [&_td]:pr-4 [&_td]:align-top [&_td]:text-black/80"
    >
      <p class="!mt-0 text-sm text-black/65">Utolsó frissítés: {updated}</p>

      <div
        class="mt-6 rounded-brand border border-dashed border-terracotta-500/40 bg-terracotta-200/40 p-5 text-sm
               leading-relaxed text-terracotta-800"
      >
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> a cégadatok
        valósak, és a dokumentum a weboldal tényleges működését írja le. Élesítés előtt
        javasolt jogi szakértővel átnézetni — ez a szöveg nem minősül jogi tanácsadásnak.
      </div>

      <slot />
    </div>
  </section>
</Base>
