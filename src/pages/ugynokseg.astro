---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import Testimonials from '@/components/Testimonials.astro';
import { agencyServices, halves, expert, site, contact } from '@/data/site';

const steps = [
  {
    title: 'Ingyenes 30 perc',
    body: 'Megnézzük, mivel foglalkozol, mi fut most, és mi a cél. Ennek alapján mondok árat — nem előre gyártott csomagot.',
  },
  {
    title: 'Átnézem, ami van',
    body: 'Fiók, mérés, korábbi eredmények. Ha valami alapvetően hiányzik, azt előre megmondom, nem a harmadik hónapban.',
  },
  {
    title: 'Felépítés és indítás',
    body: 'Megépítem a kampányokat a saját fiókodban. A hozzáférés végig a tiéd marad.',
  },
  {
    title: 'Havi riport, magyarul',
    body: 'Nem dashboard-link. Leírom, mi történt, mibe került, és mit javaslok a következő hónapra.',
  },
];

const schema = [
  {
    '@type': 'Service',
    '@id': `${site.url}/ugynokseg#service`,
    name: 'Hirdetéskezelés, fiókmenedzsment és mérés',
    serviceType: 'Online marketing ügynökségi szolgáltatás',
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'Country', name: 'Hungary' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Ügynökségi szolgáltatások',
      itemListElement: agencyServices.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.name, description: s.body },
      })),
    },
  },
];
---

<Base
  title="Ügynökség"
  description="Kampánykezelés, egyszeri fiókbeállítás, audit és mérés magyar kis- és középvállalkozásoknak. A hirdetési fiók végig a tiéd marad, nincs hűségidő."
  schema={schema}
>
  <PageHero
    eyebrow="ÜGYNÖKSÉG"
    title="Nincs rá időd? Csináljuk mi."
    lead="A Brandműhely másik fele. Ugyanaz a szakmai háttér, ugyanaz az őszinte beszéd a számokról — csak nem neked kell elvégezned."
  />

  <!-- Services -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <SectionHeading
        eyebrow="MIT CSINÁLOK"
        title="Néhány dolgot, rendesen"
        lead="Nem vállalok mindent. Azt csinálom, amihez tizenegy év tapasztalat áll mögöttem — a teljes kampánykezeléstől az egyszeri beállításig."
      />

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {agencyServices.map((svc) => (
          <article id={svc.id} class="card flex flex-col p-8 scroll-mt-28">
            <h3 class="t-subtitle text-black">{svc.name}</h3>
            <p class="t-body mt-4 text-black/80">{svc.body}</p>
            <ul class="mt-6 space-y-3 border-t border-black/10 pt-6">
              {svc.points.map((pt) => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    class="mt-1 shrink-0 text-signal">
                    <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <span class="t-small text-black/80">{pt}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Which half is for you -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <SectionHeading
        eyebrow="MELYIK VALÓ NEKED?"
        title="Megtanulod, vagy kiszervezed"
        lead="Nincs rossz válasz. Az számít, hogy mennyi időd van rá — és hogy akarod-e érteni."
        align="center"
      />

      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        {halves.map((h) => (
          <a
            href={h.href}
            data-theme={h.tone === 'terracotta' ? 'coaching' : 'agency'}
            class="group flex flex-col rounded-brand p-8 shadow-shade transition-transform duration-200 hover:-translate-y-1"
          >
            <p class:list={['t-label', h.tone === 'terracotta' ? 'text-black/70' : 'text-terracotta-200']}>
              {h.name.toUpperCase()}
            </p>
            <p class:list={['t-subtitle mt-3', h.tone === 'terracotta' ? 'text-black' : 'text-paper']}>
              {h.tagline}
            </p>
            <p class:list={['t-small mt-4 flex-1', h.tone === 'terracotta' ? 'text-black/80' : 'text-paper/80']}>
              {h.summary}
            </p>
            <span
              class:list={[
                't-label mt-6 inline-flex items-center gap-2',
                h.tone === 'terracotta' ? 'text-black' : 'text-paper',
              ]}
            >
              TOVÁBB
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <SectionHeading
            eyebrow="HOGYAN INDULUNK"
            title="Négy lépés, meglepetés nélkül"
            lead="Nincs hűségidő és nincs beköltözés a fiókodba. Bármikor kiszállhatsz, és minden ott marad, ahol volt."
          />
        </div>
        <ol class="space-y-1">
          {steps.map((s, i) => (
            <li class="group relative flex gap-6 pb-8 last:pb-0">
              <div class="relative flex flex-col items-center">
                <span
                  class="z-10 grid h-11 w-11 shrink-0 place-items-center rounded-brand
                         bg-blue-800 font-title text-sm font-bold text-paper"
                >{i + 1}</span>
                {i < steps.length - 1 && (
                  <span class="absolute top-11 h-full w-px bg-black/15" aria-hidden="true"></span>
                )}
              </div>
              <div class="pt-1.5">
                <h3 class="t-subtitle text-black">{s.title}</h3>
                <p class="t-body mt-2 max-w-lg text-black/80">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Pricing: deliberately not a price list -->
  <section class="section" data-theme="agency">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="t-label text-terracotta-200">ÁRAZÁS</p>
        <h2 class="t-title mt-4 text-paper">Itt nincs árlista — és ennek oka van</h2>
        <p class="t-lead mt-6 text-paper/85">
          A képzésnél fix árakat adok, mert ott egy alkalom egy alkalom. Kampánykezelésnél
          viszont más a munka egy havi 50 000 forintos és egy havi 2 millió forintos
          kerettel — ha itt listaárat írnék ki, az egyikőtöknek biztosan hazugság lenne.
        </p>
        <p class="t-body mt-5 text-paper/75">
          A 30 perces beszélgetés után konkrét összeget mondok. Nincs csomag, amit rád
          kell húzni, és nincs sávos árazás, ami mindig éppen fölötted kezdődik.
        </p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/kapcsolat" size="lg" track="agency-quote">Kérek ajánlatot</Button>
          <Button href="/arak" size="lg" variant="light">
            A képzés árai
          </Button>
        </div>
        <p class="t-small mt-5 text-paper/70">
          Vagy hívj közvetlenül: {contact.phone}
        </p>
      </div>
    </div>
  </section>

  <Testimonials />
</Base>
