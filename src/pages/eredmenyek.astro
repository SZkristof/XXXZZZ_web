---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Results from '@/components/Results.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faq from '@/components/Faq.astro';
import AgencyHalf from '@/components/AgencyHalf.astro';
---

<Base
  title="Eredmények"
  description="Konkrét számok konkrét vállalkozásoktól: ROAS, egy érdeklődő ára, havi lead szám — iparággal és cégmérettel együtt."
>
  <PageHero
    eyebrow="EREDMÉNYEK"
    title="Számok, nem jelzők"
    lead="Az alábbi számok valós ügyfelektől származnak, a saját szavaikkal. A cégnevet csak ott írom ki, ahol ehhez hozzájárultak — a számokat sehol nem szépítem."
  />
  <Results />
  <Testimonials />
  <Faq limit={4} />
  <AgencyHalf />
</Base>
