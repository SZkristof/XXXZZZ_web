---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Testimonials from '@/components/Testimonials.astro';
import AgencyHalf from '@/components/AgencyHalf.astro';
import { expert, brands, brandsReassurance, site } from '@/data/site';
import { num } from '@/lib/format';

const credentials = [
  { label: 'Google Ads minősítés', detail: 'Search, Display, Performance Max' },
  { label: 'Meta minősítés', detail: 'Hirdetéskezelés és mérés' },
  { label: 'Ügynökségi háttér', detail: 'Vezető magyar ügynökségek' },
  { label: 'Nemzetközi tapasztalat', detail: 'Paid media csapatok vezetése' },
];

const principles = [
  {
    title: 'A fiók a tiéd marad',
    body: 'Soha nem kérek hozzáférést azzal, hogy majd én intézem. A te fiókodban dolgozunk, a te gépeden, és minden ott is marad, amikor véget érnek az alkalmak.',
  },
  {
    title: 'Nem adok el nagyobbat, mint kell',
    body: 'Ha két alkalom elég, két alkalmat javaslok. Ha látom, hogy a te helyzetedben nem a hirdetés a szűk keresztmetszet, azt is megmondom — akkor is, ha ez nekem nem üzlet.',
  },
  {
    title: 'Magyarul, nem szakzsargonban',
    body: 'A ROAS, az attribúció és a konverziós ablak nem varázsszavak. El lehet magyarázni őket úgy, hogy egy tulajdonos értse — és csak akkor van értelmük, ha érted.',
  },
];

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/rolam#page`,
    mainEntity: { '@id': `${site.url}/#person` },
  },
];
---

<Base
  title="Rólam"
  description={`${expert.name} — ${expert.yearsExperience} év paid media tapasztalat, több mint ${expert.businessesTrained} képzett magyar vállalkozás.`}
  schema={schema}
>
  <section class="relative overflow-hidden bg-blue-800 text-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-56 left-1/3 h-[34rem] w-[34rem] -translate-x-1/2 rounded-brand
               bg-[radial-gradient(circle,rgba(255,90,31,0.20),transparent_62%)] blur-2xl"
      >
      </div>
    </div>

    <div class="container-x relative">
      <div class="grid items-center gap-12 py-16 lg:grid-cols-[1.25fr_1fr] lg:gap-16 lg:py-24">
        <div>
          <p class="t-label text-terracotta-200">Rólam</p>
          <h1 class="mt-4 text-5xl font-bold text-white">
            {expert.name}
          </h1>
          <p class="mt-5 text-xl leading-relaxed text-paper/85">{expert.shortBio}</p>
          <p class="mt-5 leading-relaxed text-paper/75">
            Ma már nem ügynökségként dolgozom, hanem megtanítom rá a vállalkozókat. Azért,
            mert évek alatt ugyanazt láttam újra és újra: a cégek fizetnek valakinek, aki
            hirdet helyettük, de közben fogalmuk sincs, mi történik a pénzükkel — és amint
            a szerződés véget ér, megáll minden.
          </p>
          <div class="mt-9">
            <Button href="/kapcsolat" size="lg" track="about-cta">
              Beszéljünk 30 percet
            </Button>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
          <div
            class="relative aspect-[4/5] overflow-hidden rounded-brand bg-blue-800 shadow-shade-lift"
          >
            <span
              class="pointer-events-none absolute inset-0 grid place-items-center font-title
                     text-[12rem] font-bold leading-none text-white/[0.04]"
              aria-hidden="true">B</span
            >
            <picture>
              <source srcset="/img/kristof-about.webp" type="image/webp" />
              <img
                src="/img/kristof-about.jpg"
                alt={expert.name}
                width="720" height="900" loading="eager" decoding="async"
                class="relative h-full w-full object-cover object-top"
              />
            </picture>
          </div>
        </div>
      </div>

      <div class="border-t border-white/10 py-9">
        <p class="t-label text-black/65">Márkák, amiken dolgoztam</p>
        <ul class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-3">
          {brands.map((b) => (
            <li class="font-title text-lg font-bold tracking-tight text-paper/75">{b}</li>
          ))}
        </ul>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-paper/75">
          <span class="font-semibold text-terracotta-200">{brandsReassurance}</span>
          {' '}A nagy márkáknál tanult módszereket hozom el olyan méretben, ami neked is működik.
        </p>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="section-tight ground-paper">
    <div class="container-x">
      <dl class="grid gap-px overflow-hidden rounded-brand bg-black/10 sm:grid-cols-2 lg:grid-cols-4">
        {credentials.map((c) => (
          <div class="bg-white p-7">
            <dt class="font-title text-base font-bold text-black">{c.label}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-black/72">{c.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Principles -->
  <section class="section ground-paper">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="t-label text-terracotta-800">Ahogy dolgozom</p>
        <h2 class="mt-3 text-4xl">Három dolog, amiből nem engedek</h2>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {principles.map((p, i) => (
          <div class="card p-7">
            <span class="font-title text-xs font-bold tracking-widest text-terracotta-800">
              0{i + 1}
            </span>
            <h3 class="mt-4 font-title text-xl font-bold text-black">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-black/72">{p.body}</p>
          </div>
        ))}
      </div>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-brand bg-black/10 sm:grid-cols-3"
      >
        {[
          { n: `${num(expert.businessesTrained)}+`, l: 'vállalkozás, akit képeztem' },
          { n: `${expert.yearsExperience} év`, l: 'paid media tapasztalat' },
          { n: 'Agrártól a jógáig', l: 'iparágtól függetlenül működik' },
        ].map((s) => (
          <div class="bg-white px-6 py-9 text-center">
            <dt class="sr-only">{s.l}</dt>
            <dd>
              <span class="block font-title text-3xl font-bold tracking-tight text-black">
                {s.n}
              </span>
              <span class="mt-2 block text-sm text-black/72">{s.l}</span>
            </dd>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <AgencyHalf />
</Base>
