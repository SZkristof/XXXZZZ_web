---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Slabs from '@/components/Slabs.astro';
import Pricing from '@/components/Pricing.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faq from '@/components/Faq.astro';
import {
  courses, site, contact, expert, SESSION_LENGTH_MIN,
  whyOneToOne, courseNotFor, courseTerms,
} from '@/data/site';
import { faqs } from '@/data/proof';

/**
 * One sales page per platform, generated from `courses`.
 *
 * They exist because of how people search. Nobody types "hirdetési képzés";
 * they type "facebook hirdetés egyéni oktatás" — and the page that answers
 * that has to be one whose entire subject is that platform, not a section of
 * a page about three of them.
 *
 * The funnel is the one already proven on /ugynokseg: symptom → what we go
 * through → what you can do afterwards → how it runs → proof → price →
 * questions → close. Only the subject changes per page, so the shape is
 * worth keeping identical: a visitor who bounces between two of these pages
 * should recognise the structure immediately.
 *
 * Coaching half, so terracotta. As on the agency page the colour marks the
 * three moments that carry the offer — the opening, the facts strip and the
 * close — while the argument between them sits on linen.
 */

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props;
const url = `${site.url}/oktatas/${course.slug}`;

const schema = [
  {
    '@type': 'Course',
    '@id': `${url}#course`,
    name: course.name,
    description: course.lead,
    inLanguage: 'hu',
    provider: { '@id': `${site.url}/#business` },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: ['online', 'onsite'],
      courseWorkload: `PT${SESSION_LENGTH_MIN}M`,
      instructor: { '@type': 'Person', name: expert.name },
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: course.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const facts = [
  { k: 'ALKALMANKÉNT', v: `${SESSION_LENGTH_MIN} perc` },
  { k: 'HETENTE MAX.', v: '2 alkalom' },
  { k: 'HELYSZÍN', v: 'Online vagy Budapesten' },
  { k: 'VISSZANÉZHETŐ', v: 'Igen, ingyen' },
];

/* The platform-specific questions first, because someone on this page is
   asking about this platform; the shared ones follow. */
const pageFaqs = [...course.faqs, ...faqs.slice(0, 4)];
---

<Base title={course.name} description={course.lead} schema={schema}>
  <!-- 1 · Opening. -->
  <section data-theme="coaching" class="relative overflow-hidden">
    <Slabs group="triplet" color="var(--color-black)" opacity={0.08} height="420px" />
    <div class="container-x relative z-10 py-16 lg:py-24">
      <div class="max-w-[54rem]">
        <p class="t-label t-eyebrow">{course.eyebrow}</p>
        <h1 class="t-display mt-5 max-w-[22ch]">{course.headline}</h1>
        <p class="t-lead mt-6 max-w-[54ch]">{course.lead}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="/kapcsolat" size="lg" track={`course-${course.slug}-hero`}>
            Ingyenes 30 perces konzultáció
          </Button>
          <span class="t-small text-black/75">
            Nem kell rá készülnöd, és nem lesz belőle értékesítési hívás.
          </span>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-5 border-t border-black/20 pt-8 sm:grid-cols-4">
          {facts.map((f) => (
            <div>
              <dt class="t-label text-black">{f.k}</dt>
              <dd class="mt-1.5 font-title text-lg font-bold leading-snug">{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 2 · Self-recognition. -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <SectionHeading
        eyebrow="ISMERŐS?"
        title="Ha ezek közül akár egy igaz rád, jó helyen jársz."
      />
      <ul class="mt-10 grid gap-x-10 gap-y-4 md:grid-cols-2">
        {course.symptoms.map((s) => (
          <li class="flex items-start gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="mt-0.5 shrink-0 text-signal">
              <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="t-body text-black/80">{s}</span>
          </li>
        ))}
      </ul>
      <p class="t-lead mt-10 max-w-[48ch] font-medium">
        Egyik sem azért van, mert nem vagy elég okos hozzá. Azért, mert senki nem
        mutatta meg — és a felület nem magyarázza el.
      </p>
    </div>
  </section>

  <!-- 2b · Why one-to-one at all. The visitor is comparing this against a
       cheap recorded course, so the comparison has to happen on the page. -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <SectionHeading
        eyebrow="MIÉRT EGYÉNI"
        title="Miért ne egy felvett tanfolyamot nézz meg inkább?"
        lead="Mert az olcsóbb — és ha beválik, tényleg azt válaszd. Négy dolog, amit egy felvett tananyag nem tud megadni."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {whyOneToOne.map((w) => (
          <div class="card p-7">
            <h3 class="font-title text-lg font-bold tracking-tight text-black">{w.t}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-black/72">{w.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · The curriculum. The single most-read block on a page like this:
       it is what tells someone whether the money buys anything specific. -->
  <section class="section" data-theme="shared" id="tananyag">
    <div class="container-x">
      <SectionHeading
        eyebrow="MIT VESZÜNK ÁT"
        title="Ezeken megyünk végig, a saját fiókodban"
        lead="Nem előre felvett tananyag. A sorrend fix, a tempó a tiéd — ahol már otthon vagy, ott gyorsabban haladunk."
      />
      <ol class="mt-12 grid gap-5 md:grid-cols-2">
        {course.curriculum.map((m, i) => (
          <li class="card flex gap-5 p-7">
            <span
              class="grid h-10 w-10 shrink-0 place-items-center rounded-brand bg-terracotta-500
                     font-title text-sm font-bold text-black"
              aria-hidden="true"
            >{i + 1}</span>
            <div>
              <h3 class="font-title text-lg font-bold leading-snug tracking-tight text-black">
                {m.title}
              </h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-black/72">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4 · What they can do afterwards. The curriculum is the input; this is
       the output, and it is the thing actually being bought. -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="t-label t-eyebrow">A VÉGÉN</p>
          <h2 class="t-title mt-4">Mit fogsz tudni egyedül megcsinálni?</h2>
          <p class="t-body mt-6 text-black/80">
            Az a cél, hogy ne legyen rám szükséged. Ha az oktatás után is minden
            kérdésnél engem kell hívnod, akkor nem tanítottam meg, csak csináltam
            helyetted.
          </p>
          <div class="mt-8">
            <Button href="/kapcsolat" size="lg" track={`course-${course.slug}-outcomes`}>
              Beszéljük át
            </Button>
          </div>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {course.outcomes.map((o) => (
            <li class="card flex items-start gap-3 p-6">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                class="mt-0.5 shrink-0 text-signal">
                <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="t-small font-medium text-black">{o}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5 · Proof, then price, then questions. -->
  <Testimonials />
  <Pricing />
  <!-- 5b · The three terms that decide a purchase, and a real filter.
       Stated as his own terms, never as a comparison: naming a competitor's
       prices is comparative advertising, and the Tpvt. holds that to a
       standard a sales page should not have to meet. -->
  <section class="section" data-theme="shared">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <p class="t-label t-eyebrow">TISZTA FELTÉTELEK</p>
          <h2 class="t-title mt-4">Amit az árnál látsz, annyit fizetsz</h2>
          <dl class="mt-8 space-y-6">
            {courseTerms.map((t) => (
              <div class="border-t border-black/10 pt-5">
                <dt class="font-title text-lg font-bold tracking-tight text-black">{t.t}</dt>
                <dd class="mt-2 text-[0.9375rem] leading-relaxed text-black/72">{t.b}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="card p-8">
          <p class="t-subtitle">Ne ezt válaszd, ha…</p>
          <ul class="mt-6 space-y-4">
            {courseNotFor.map((n) => (
              <li class="flex items-start gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                  class="mt-1 shrink-0 text-black/40">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round"></path>
                </svg>
                <span class="t-small text-black/80">{n}</span>
              </li>
            ))}
          </ul>
          <p class="t-small mt-6 border-t border-black/10 pt-5 text-black/65">
            Ezt nem udvariasságból írom ki. A 30 perces beszélgetésen úgyis kiderül —
            jobb, ha addigra mindketten tudjuk.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq
    items={pageFaqs}
    eyebrow="GYIK"
    title={`Amit a ${course.platform} oktatásról kérdezni szoktak`}
    lead="Ha nincs köztük a tiéd, írj vagy hívj — a 30 percben úgyis mindent átbeszélünk."
  />

  <!-- 6 · Close, plus the other platforms. Someone who got this far and
       picked the wrong page should not have to go back to the menu. -->
  <section data-theme="coaching">
    <div class="container-x section">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="t-title">Kezdjük egy beszélgetéssel</h2>
        <p class="t-lead mt-5 max-w-[52ch] mx-auto">
          30 perc, ingyen. Elmondod, hol tartasz, és megmondom, mennyi alkalom kell
          hozzá — vagy azt, hogy nálam most nem ez a legjobb választás neked.
        </p>
        <div class="mt-9 flex justify-center">
          <Button href="/kapcsolat" size="lg" track={`course-${course.slug}-final`}>
            Ingyenes 30 perces konzultáció
          </Button>
        </div>
        <p class="t-small mt-6 text-black/75">Vagy hívj: {contact.phone}</p>
      </div>
    </div>
  </section>

  <section class="section-tight" data-theme="shared">
    <div class="container-x">
      <p class="t-label t-eyebrow">MÁS PLATFORM ÉRDEKEL?</p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {courses.filter((c) => c.slug !== course.slug).map((c) => (
          <li>
            <a
              href={`/oktatas/${c.slug}`}
              class="inline-block rounded-brand bg-white px-4 py-2.5 text-[0.9375rem]
                     font-medium text-black shadow-shade transition-transform
                     duration-200 hover:-translate-y-0.5"
            >{c.navLabel}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
