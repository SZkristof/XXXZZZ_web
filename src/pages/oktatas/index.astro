---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Platforms from '@/components/Platforms.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Pricing from '@/components/Pricing.astro';
import Faq from '@/components/Faq.astro';
import Button from '@/components/Button.astro';
import { tracks, packages, site, courses } from '@/data/site';

const schema = tracks.map((t) => ({
  '@type': 'Course',
  '@id': `${site.url}/oktatas#${t.slug}`,
  name: t.headline,
  description: t.description,
  inLanguage: 'hu',
  provider: { '@id': `${site.url}/#business` },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT1H',
  },
}));
---

<Base
  title="Oktatás"
  description="Három út, attól függően hol tartasz: kezdőként nulláról, futó kampányok rendbetétele, vagy vezetőként a számok megértése."
  schema={schema}
>
  <PageHero
    mode="coaching"
    eyebrow="EGYÉNI OKTATÁS"
    title="Három út. Válaszd azt, ahol most vagy."
    lead="Nem ugyanazt tanítom annak, aki még el sem indult, és annak, aki már két ügynökségen van túl. Az első, ingyenes beszélgetésen közösen eldöntjük, melyik a tiéd."
  />

  <!-- Platform choice first. This page is what the Oktatás menu item opens,
       and whoever opened it is picking a platform — the three buyer
       situations below are the second question, not the first.

       All five live here and in the submenu only. The homepage deliberately
       stays on Meta / Google / LinkedIn: TikTok and GA4 are offered, but
       Kristóf does not want them fronted to someone who has not already
       come looking for training. -->
  <section class="section" data-theme="shared" id="platformok-oktatas">
    <div class="container-x">
      <SectionHeading
        eyebrow="VÁLASSZ PLATFORMOT"
        title="Melyik felületet tanulnád meg?"
        lead="Mindegyik ugyanúgy működik: 60 perces alkalmak a saját fiókodban, a saját termékeiden. Csak a tananyag más."
      />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {courses.map((c) => (
          <li class="contents">
            <a
              href={`/oktatas/${c.slug}`}
              data-track={`oktatas-${c.slug}`}
              class="group card flex h-full flex-col p-7 transition-all duration-300 ease-out
                     hover:-translate-y-1 hover:shadow-shade-lift focus-visible:-translate-y-1"
            >
              <span class="t-label t-eyebrow">{c.platform.toUpperCase()}</span>
              <h3 class="mt-4 font-title text-xl font-bold leading-snug tracking-tight text-black">
                {c.navLabel}
              </h3>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-black/72">
                {c.summary}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 font-title text-[0.9375rem] font-bold text-highlight">
                Részletek
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                  class="transition-transform duration-300 ease-out group-hover:translate-x-1.5">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" data-theme="shared">
    <div class="container-x space-y-6">
      {tracks.map((t, i) => {
        const rec = packages.find((p) => p.id === t.recommended)!;
        return (
          <article
            id={t.slug}
            class="scroll-mt-28 overflow-hidden card"
          >
            <div class="grid lg:grid-cols-[1.35fr_1fr]">
              <div class="p-8 sm:p-10 lg:p-12">
                <div class="flex items-center gap-3">
                  <span
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-brand bg-blue-800
                           font-title text-sm font-bold text-white"
                  >0{i + 1}</span>
                  <span class="t-label text-terracotta-800">{t.label}</span>
                </div>

                <p class="mt-7 font-title text-xl font-bold italic leading-snug text-black/65">
                  „{t.symptom}"
                </p>

                <h2 class="mt-5 text-3xl">{t.headline}</h2>
                <p class="mt-5 max-w-xl leading-relaxed text-black/72">{t.description}</p>

                <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                  <Button href="/kapcsolat" track={`program-${t.slug}`}>
                    Ingyenes konzultáció
                  </Button>
                  <Button href="/arak" variant="light">Árak megnézése</Button>
                </div>
              </div>

              <div class="border-t border-black/10 bg-paper p-8 sm:p-10 lg:border-l lg:border-t-0">
                <h3 class="t-label text-black/65">Mivel leszel gazdagabb</h3>
                <ul class="mt-5 space-y-3.5">
                  {t.outcomes.map((o) => (
                    <li class="flex items-start gap-3">
                      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                        class="mt-0.5 shrink-0 text-signal">
                        <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                      <span class="text-[0.9375rem] leading-relaxed text-black/80">{o}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-7 card p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-black/65">
                    Ehhez jellemzően elég
                  </p>
                  <p class="mt-1.5 font-title text-lg font-bold text-black">
                    {t.recommendedLabel}
                  </p>
                  {rec.deal && (
                    <p class="mt-1 text-sm text-black/72">
                      {rec.deal} — {rec.dealExplainer}
                    </p>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <Platforms />
  <HowItWorks />
  <Pricing detailed />
  <Faq limit={5} />
</Base>
