---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site, expert } from '@/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${site.url}/blog/${post.id}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#business` },
    inLanguage: 'hu-HU',
    mainEntityOfPage: `${site.url}/blog/${post.id}`,
  },
];
---

<Base title={post.data.title} description={post.data.description} schema={schema}>
  <article>
    <header class="bg-ink-950 text-white">
      <div class="container-prose py-14 sm:py-20">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium text-ink-400
                 transition-colors hover:text-white"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Vissza a bloghoz
        </a>

        <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-ink-400">
          <span class="rounded-md bg-white/10 px-2.5 py-1 text-xs font-semibold text-ember-300">
            {post.data.category}
          </span>
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.readingMinutes} perc olvasás</span>
        </div>

        <h1 class="mt-5 text-4xl font-extrabold text-white">{post.data.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-300">{post.data.description}</p>
      </div>
    </header>

    <div class="section-tight bg-white">
      <div
        class="container-prose
               [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:first:mt-0
               [&_h3]:mt-9 [&_h3]:text-xl
               [&_p]:mt-5 [&_p]:leading-relaxed [&_p]:text-ink-700
               [&_ul]:mt-5 [&_ul]:space-y-2.5 [&_ul]:pl-5
               [&_ol]:mt-5 [&_ol]:space-y-2.5 [&_ol]:pl-5
               [&_li]:list-disc [&_li]:leading-relaxed [&_li]:text-ink-700 [&_li]:marker:text-ember-500
               [&_ol>li]:list-decimal
               [&_strong]:font-semibold [&_strong]:text-ink-950
               [&_a]:font-medium [&_a]:text-ember-700 [&_a]:underline [&_a]:underline-offset-2
               [&_blockquote]:mt-8 [&_blockquote]:border-l-4 [&_blockquote]:border-ember-500
               [&_blockquote]:bg-ink-50 [&_blockquote]:py-4 [&_blockquote]:pl-6 [&_blockquote]:pr-5
               [&_blockquote]:font-display [&_blockquote]:text-lg [&_blockquote]:font-semibold
               [&_blockquote]:text-ink-900
               [&_blockquote_p]:mt-0"
      >
        <Content />
      </div>
    </div>

    <!-- Post-read CTA -->
    <div class="section-tight bg-white">
      <div class="container-prose">
        <div class="rounded-2xl border border-ink-200 bg-ink-50 p-8 text-center sm:p-10">
          <h2 class="text-2xl">Ezt a saját fiókodban is át tudjuk nézni</h2>
          <p class="mx-auto mt-3 max-w-lg leading-relaxed text-ink-600">
            30 perc, ingyen, kötelezettség nélkül. Megnézzük, mi fut most nálad, és
            megmondom, hol van a legnagyobb tartalék.
          </p>
          <div class="mt-7">
            <Button href="/kapcsolat" size="lg" track="blog-cta">
              Ingyenes konzultáció
            </Button>
          </div>
          <p class="mt-5 text-sm text-ink-500">
            {expert.name} · {expert.yearsExperience} év paid media tapasztalat
          </p>
        </div>
      </div>
    </div>
  </article>
</Base>
