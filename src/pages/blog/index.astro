---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const chip: Record<string, string> = {
  'Meta Ads': 'bg-blue-50 text-blue-800',
  'Google Ads': 'bg-amber-50 text-amber-900',
  'LinkedIn Ads': 'bg-sky-50 text-sky-900',
  'Általános': 'bg-ink-100 text-ink-700',
};
---

<Base
  title="Blog"
  description="Hírek, változások és gyakorlati tippek a Meta, Google és LinkedIn hirdetéskezelőkről — magyarul, vállalkozóknak."
>
  <PageHero
    eyebrow="Blog"
    title="Ami tényleg változik a hirdetéskezelőkben"
    lead="Nem hírfolyam. Csak az, aminek hatása van arra, amit a saját fiókodban csinálsz — és hogy pontosan mit kezdj vele."
  />

  <section class="section bg-white">
    <div class="container-x">
      {posts.length === 0 ? (
        <p class="text-ink-600">Hamarosan érkeznek az első bejegyzések.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article
              class="group flex flex-col rounded-2xl border border-ink-200 bg-white
                     transition-all duration-300 hover:-translate-y-1 hover:shadow-lift"
            >
              <a href={`/blog/${post.id}`} class="flex h-full flex-col p-7">
                <div class="flex items-center gap-3">
                  <span
                    class:list={[
                      'rounded-md px-2.5 py-1 text-xs font-semibold',
                      chip[post.data.category] ?? chip['Általános'],
                    ]}
                  >{post.data.category}</span>
                  <span class="text-xs text-ink-500">{post.data.readingMinutes} perc</span>
                </div>

                <h2
                  class="mt-5 font-display text-xl font-bold leading-snug text-ink-950
                         transition-colors group-hover:text-ember-700"
                >{post.data.title}</h2>

                <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">
                  {post.data.description}
                </p>

                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="mt-6 block text-sm text-ink-500"
                >{fmt(post.data.pubDate)}</time>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
