---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

/**
 * These chips used to colour-code the platform with Tailwind's default amber,
 * sky and blue scales. Three problems at once: those colours are not among
 * the brand's ten; amber sits in the banned 20–70° hue band; and sky is
 * platform blue, also banned outright.
 *
 * The brand's answer is `bm-tag`, the 13° parallelogram. Its three variants
 * are coaching, agency and neutral — a half, not a platform — so every post
 * chip is neutral. Inventing a terracotta-for-Meta / blue-for-Google mapping
 * would quietly reassign the two colours that carry the business's halves.
 */
---

<Base
  title="Blog"
  description="Hírek, változások és gyakorlati tippek a Meta, Google és LinkedIn hirdetéskezelőkről — magyarul, vállalkozóknak."
>
  <PageHero
    eyebrow="BLOG"
    title="Ami tényleg változik a hirdetéskezelőkben"
    lead="Nem hírfolyam. Csak az, aminek hatása van arra, amit a saját fiókodban csinálsz — és hogy pontosan mit kezdj vele."
  />

  <section class="section bg-white">
    <div class="container-x">
      {posts.length === 0 ? (
        <p class="text-black/72">Hamarosan érkeznek az első bejegyzések.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article
              class="group flex flex-col rounded-brand border border-black/10 bg-white
                     transition-all duration-300 hover:-translate-y-1 hover:shadow-shade-lift"
            >
              <a href={`/blog/${post.id}`} class="flex h-full flex-col p-7">
                <div class="flex items-center gap-3">
                  <span class="bm-tag bm-tag--neutral">{post.data.category}</span>
                  <span class="text-xs text-black/65">{post.data.readingMinutes} perc</span>
                </div>

                <h2
                  class="mt-5 font-title text-xl font-bold leading-snug text-black
                         transition-colors group-hover:text-terracotta-800"
                >{post.data.title}</h2>

                <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-black/72">
                  {post.data.description}
                </p>

                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="mt-6 block text-sm text-black/65"
                >{fmt(post.data.pubDate)}</time>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
