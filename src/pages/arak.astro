---
import Base from '@/layouts/Base.astro';
import Pricing from '@/components/Pricing.astro';
import Faq from '@/components/Faq.astro';
import Comparison from '@/components/Comparison.astro';
import AgencyHalf from '@/components/AgencyHalf.astro';
import { site, packages } from '@/data/site';

const schema = [
  {
    '@type': 'Product',
    '@id': `${site.url}/arak#product`,
    name: 'Egyéni hirdetési képzés',
    description: 'Meta, Google és LinkedIn hirdetési képzés 1 az 1-ben, magyar KKV-knak.',
    brand: { '@id': `${site.url}/#business` },
    offers: packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price,
      priceCurrency: 'HUF',
      availability: 'https://schema.org/InStock',
      url: `${site.url}/arak`,
    })),
  },
];
---

<Base
  title="Árak"
  description="Egy alkalom 35 000 Ft. 5 alkalom 140 000 Ft (4+1), 10 alkalom 245 000 Ft (7+3). Nincs havidíj, nincs hűségidő, nincs rejtett költség."
  schema={schema}
>
  <!-- No hero: Kristóf's call, and the price list is the page. It therefore
       carries the h1 — a page with no h1 is one neither Google nor a screen
       reader can summarise. -->
  <Pricing detailed level={1} />
  <Comparison />
  <Faq />
  <AgencyHalf />
</Base>
