---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SocialProof from '@/components/SocialProof.astro';
import Services from '@/components/Services.astro';
import CourseIntro from '@/components/CourseIntro.astro';
import Comparison from '@/components/Comparison.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Platforms from '@/components/Platforms.astro';
import Results from '@/components/Results.astro';
import Testimonials from '@/components/Testimonials.astro';
import Pricing from '@/components/Pricing.astro';
import Faq from '@/components/Faq.astro';
import AgencyHalf from '@/components/AgencyHalf.astro';
import { site, packages } from '@/data/site';
import { faqs } from '@/data/proof';

const HOME_FAQ_COUNT = 6;

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faqs.slice(0, HOME_FAQ_COUNT).map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'Service',
    '@id': `${site.url}/#service`,
    name: 'Egyéni Meta, Google és LinkedIn hirdetési képzés',
    serviceType: 'Online marketing oktatás',
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'Country', name: 'Hungary' },
    offers: packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price,
      priceCurrency: 'HUF',
      url: `${site.url}/arak`,
      availability: 'https://schema.org/InStock',
    })),
  },
];
---

<Base
  title="Egyéni Meta, Google és LinkedIn hirdetési képzés"
  description={site.description}
  schema={schema}
>
  <Hero />
  <SocialProof />
  <Services />
  <CourseIntro />
  <Comparison />
  <HowItWorks />
  <Platforms />
  <Results />
  <Testimonials />
  <Pricing />
  <Faq limit={HOME_FAQ_COUNT} />
  <AgencyHalf />
</Base>
