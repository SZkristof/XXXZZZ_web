---
import { MARK_D, WORDMARK_D, LOCKUP } from '@/lib/logo-paths';

/**
 * A Vágás and the Brandműhely wordmark.
 *
 * THE LOCKUP IS ONE DRAWING, NOT TWO SVGS SIDE BY SIDE. The previous version
 * put the mark and the wordmark in a flex row aligned on their bottom edges,
 * which is wrong: the wordmark's box runs 194 units BELOW the baseline to
 * leave room for descenders, while the mark's box ends at its own foot. That
 * pushed the mark 194 units — 5.4px at the header size — below the
 * wordmark's baseline, when the brand book places it exactly ON that
 * baseline ("mark at cap height on the baseline, two-module gap").
 *
 * So the lockup now uses the book's own measured placement: the mark
 * translated so its foot lands at y=0, and the wordmark shifted right by
 * exactly two modules. Never eyeball this relationship again — it is the
 * kind of error that looks like nothing and reads as amateurish.
 *
 * The logo is ALWAYS one colour, the text colour of whatever it sits on, so
 * everything fills with currentColor. Minimum sizes from the book: mark 16px
 * wide, wordmark and horizontal lockup 96px wide. Clear space: one cap
 * height.
 */
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  /** Cap height in px. Cap height is 687 units in every file, so this one
   *  number scales all three variants consistently. */
  size?: number;
  class?: string;
  /** Rendered as a link when set. */
  href?: string;
  label?: string;
}

const {
  variant = 'lockup',
  size = 40,
  class: className = '',
  href,
  label = 'Brandműhely',
} = Astro.props;

const CAP = 687;
const BOX = {
  mark: { viewBox: '0 0 826.2 687', w: 826.2, h: CAP },
  wordmark: { viewBox: '83 -725 6722 919', w: 6722, h: 919 },
  lockup: { viewBox: LOCKUP.viewBox, w: 7879, h: 919 },
}[variant];

const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['inline-block', className]}
  {...href ? { href, 'aria-label': label } : {}}
>
  <svg
    viewBox={BOX.viewBox}
    width={Math.round((size * BOX.w) / CAP)}
    height={Math.round((size * BOX.h) / CAP)}
    fill="currentColor"
    role="img"
    aria-label={label}
    style="display:block"
  >
    {variant === 'mark' && <path d={MARK_D} />}
    {variant === 'wordmark' && <path d={WORDMARK_D} />}
    {variant === 'lockup' && (
      <Fragment>
        <path d={MARK_D} transform={LOCKUP.markTransform} />
        <path d={WORDMARK_D} transform={LOCKUP.wordmarkTransform} />
      </Fragment>
    )}
  </svg>
</Tag>
