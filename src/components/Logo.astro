---
/**
 * A Vágás — the Brandműhely mark and wordmark.
 *
 * These are the brand book's own outlined files (Logos asset group), not a
 * reconstruction. The previous version of this component approximated both
 * from polygons and got the proportion wrong: it drew the mark square, when
 * A Vágás is 826.2 x 687 units — about 1.2 : 1 — precisely so that it stands
 * on the wordmark's cap line. Never redraw these; they are measured from
 * Archivo 700 outlines and the wordmark is tracked -3%, chosen from renders
 * at -2, -3 and -4% because at -4% the r starts touching the a.
 *
 * The logo is ALWAYS one colour — the text colour of whatever it sits on —
 * so both fill with currentColor and need nothing else. Minimum sizes from
 * the book: mark 16px wide, wordmark and horizontal lockup 96px wide.
 * Clear space: one cap height.
 */
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  /** Cap height in px — the mark's height, and the wordmark's cap line. */
  size?: number;
  class?: string;
  /** Rendered as a link when set. */
  href?: string;
  label?: string;
}

const {
  variant = 'lockup',
  size = 40,
  class: className = '',
  href,
  label = 'Brandm\u0171hely',
} = Astro.props;

/* Measured from the source files. The mark is 826.2 x 687; the wordmark's
   viewBox runs 83 -725 6722 919, so its cap height is 687 units like the
   mark's, and both scale off the same number. */
const MARK_RATIO = 826.2 / 687;
const WORDMARK_RATIO = 6722 / 687;

const markW = Math.round(size * MARK_RATIO);
const wordW = Math.round(size * WORDMARK_RATIO);

const Tag = href ? 'a' : 'div';
const showMark = variant !== 'wordmark';
const showWord = variant !== 'mark';
---

<Tag
  class:list={['inline-flex items-baseline', showMark && showWord && 'gap-[0.28em]', className]}
  style={`font-size:${size}px`}
  {...href ? { href, 'aria-label': label } : {}}
>
  {showMark && (
    <svg
      viewBox="0 0 826.2 687"
      width={markW}
      height={size}
      fill="currentColor"
      role={showWord ? undefined : 'img'}
      aria-label={showWord ? undefined : label}
      aria-hidden={showWord ? 'true' : undefined}
      style="display:block"
    >
      <path d="M0.0 0.0 L244.5 0.0 L85.9 687.0 L0.0 687.0 Z M409.8 0.0 L575.0 0.0 L416.4 687.0 L251.2 687.0 Z M740.2 0.0 L826.2 0.0 L826.2 687.0 L581.6 687.0 Z" />
    </svg>
  )}

  {showWord && (
    <svg
      viewBox="83 -725 6722 919"
      width={wordW}
      height={Math.round(size * (919 / 687))}
      fill="currentColor"
      role={showMark ? 'img' : 'img'}
      aria-label={label}
      style="display:block"
