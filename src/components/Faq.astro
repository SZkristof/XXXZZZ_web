---
import SectionHeading from '@/components/SectionHeading.astro';
import { faqs } from '@/data/proof';

interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<!-- Native <details>: fully accessible and keyboard-operable with zero JS. -->
<section class="section ground-paper" id="gyik">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          eyebrow="GYAKORI KÉRDÉSEK"
          title="Amit a legtöbben megkérdeznek"
          lead="Ha nincs köztük a tiéd, írj vagy hívj — 30 percben úgyis mindent átbeszélünk."
        />
      </div>

      <div class="divide-y divide-black/10 border-y border-black/10">
        {items.map((f) => (
          <details class="group">
            <summary
              class="flex cursor-pointer list-none items-start justify-between gap-6 py-6
                     font-title text-lg font-bold text-black transition-colors
                     hover:text-terracotta-800 [&::-webkit-details-marker]:hidden"
            >
              {f.q}
              <span
                class="relative mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-brand
                       bg-black/5 transition-colors group-open:bg-terracotta-500"
                aria-hidden="true"
              >
                <span class="absolute h-0.5 w-3 rounded bg-black transition-colors group-open:bg-black"></span>
                <span
                  class="absolute h-3 w-0.5 rounded bg-black transition-all duration-300
                         group-open:rotate-90 group-open:bg-black"
                ></span>
              </span>
            </summary>
            <div class="pb-6 pr-10">
              <p class="leading-relaxed text-black/72">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
