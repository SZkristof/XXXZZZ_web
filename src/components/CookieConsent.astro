---
import Logo from '@/components/Logo.astro';

/**
 * GDPR consent dialog.
 *
 * REJECTING IS ONE LAYER DOWN, NOT ON THE FIRST SCREEN. That is a deliberate
 * decision by Kristóf, taken on 2026-10-11 after I set out the opposite case:
 * the EDPB's cookie-banner taskforce treats "no reject on the first layer" as
 * a violation, and it is what the CNIL fined Google and Facebook for. He
 * weighed that against a Hungarian agency that does GDPR consulting shipping
 * exactly this pattern, decided the risk was his to carry, and asked for it.
 *
 * So: do not "fix" this back to three equal buttons as a tidy-up. If it
 * changes, it changes because he says so.
 *
 * Everything the law does require is here — the categories are off by
 * default, nothing is pre-ticked, refusing is genuinely possible and takes
 * one click to reach, the detail layers say exactly what each category does,
 * and the choice is revocable from the footer on every page.
 *
 * Choices sync into Google Consent Mode v2 and Meta's fbq consent.
 */
---

<div
  id="consent"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/60 p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-title"
>
  <div class="card w-full max-w-2xl overflow-hidden shadow-shade-lift">
    <!-- Header: the mark alone, at the size the book gives it in a tight slot. -->
    <div class="flex items-center justify-between border-b border-black/10 px-5 py-4 sm:px-7">
      <Logo variant="mark" size={22} class="text-black" />
      <a
        href="/cookie/"
        class="t-small font-medium text-terracotta-800 underline underline-offset-2"
      >Cookie tájékoztató</a>
    </div>

    <!-- Tabs. The indicator is a neutral rule: the brand allows no coloured
         ones, so the active state is carried by weight and colour of the
         label instead. -->
    <div class="flex border-b border-black/10" role="tablist">
      <button
        type="button" role="tab" data-tab="consent" aria-selected="true"
        class="c-tab flex-1 border-b-2 border-black px-3 py-3.5 font-title text-sm font-bold text-black"
      >Beleegyezés</button>
      <button
        type="button" role="tab" data-tab="details" aria-selected="false"
        class="c-tab flex-1 border-b-2 border-transparent px-3 py-3.5 font-title text-sm font-bold text-black/55 transition-colors hover:text-black"
      >Részletek</button>
      <button
        type="button" role="tab" data-tab="about" aria-selected="false"
        class="c-tab flex-1 border-b-2 border-transparent px-3 py-3.5 font-title text-sm font-bold text-black/55 transition-colors hover:text-black"
      >A sütikről</button>
    </div>

    <div class="max-h-[46vh] overflow-y-auto px-5 py-5 sm:px-7 sm:py-6">
      <!-- 1 · The ask. -->
      <div data-panel="consent">
        <h2 id="consent-title" class="font-title text-lg font-bold leading-snug text-black">
          Sütiket használok a méréshez és a hirdetéseimhez
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-black/80">
          A sütik segítenek megérteni, hogyan találsz rám, melyik oldal érdekel igazán, és
          melyik hirdetésem éri meg. Ugyanezeket az adatokat használom a Google Ads és a
          Meta kampányaim mérésére — ettől tudok olyat eléd tenni, aminek van értelme, és
          nem olyat, ami csak zaj.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-black/80">
          <strong class="font-semibold text-black">Ezért kérlek, engedélyezd a mérést.</strong>
          Adatot nem adok el és nem adok tovább, a döntésedet pedig bármikor
          megváltoztathatod a lap alján. Köszönöm.
        </p>
      </div>

      <!-- 2 · Categories. Nothing is pre-ticked. -->
      <div data-panel="details" class="hidden space-y-4">
        <label class="flex cursor-not-allowed items-start gap-3 opacity-60">
          <input type="checkbox" checked disabled class="mt-0.5 h-4 w-4 accent-signal" />
          <span class="text-sm">
            <span class="font-semibold text-black">Működéshez szükséges</span>
            <span class="block leading-relaxed text-black/72">
              Az oldal alapvető működése és a süti-döntésed megjegyzése. Nem kapcsolható ki.
            </span>
          </span>
        </label>
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" id="c-analytics" class="mt-0.5 h-4 w-4 accent-signal" />
          <span class="text-sm">
            <span class="font-semibold text-black">Analitika</span>
            <span class="block leading-relaxed text-black/72">
              Google Analytics — hányan járnak az oldalon, honnan érkeznek, mit néznek meg.
            </span>
          </span>
        </label>
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" id="c-marketing" class="mt-0.5 h-4 w-4 accent-signal" />
          <span class="text-sm">
            <span class="font-semibold text-black">Marketing</span>
            <span class="block leading-relaxed text-black/72">
              Meta Pixel és Google Ads — a hirdetéseim mérése és célzása.
            </span>
          </span>
        </label>
        <p class="border-t border-black/10 pt-4 text-sm text-black/72">
          Nem szeretnél semmit?
          <button
            type="button" id="c-reject"
            class="font-medium text-terracotta-800 underline underline-offset-2"
          >Csak a szükségeseket engedélyezem</button>
        </p>
      </div>

      <!-- 3 · What a cookie is, in two sentences. -->
      <div data-panel="about" class="hidden">
        <p class="text-sm leading-relaxed text-black/80">
          A süti egy apró fájl, amit a böngésződ tárol. Van, amelyik nélkül az oldal nem
          működik — például az, amelyik megjegyzi ezt a döntésedet. Más sütik azt mérik,
          hogyan használod az oldalt, vagy azt, hogy egy hirdetésem elvezetett-e ide.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-black/80">
          A mérésre a Google Analyticset, a Google Ads-t és a Meta Pixelt használom. Hogy
          pontosan melyik süti mit csinál és meddig él, az a
          <a href="/cookie/" class="font-medium text-terracotta-800 underline underline-offset-2"
            >cookie tájékoztatóban</a> van tételesen.
        </p>
      </div>
    </div>

    <!-- Buttons. Accept sits first on phones, where the thumb is. -->
    <div
      class="flex flex-col gap-2.5 border-t border-black/10 px-5 py-4
             sm:flex-row-reverse sm:px-7 sm:py-5"
    >
      <button
        type="button" id="c-accept"
        class="rounded-brand bg-terracotta-500 px-5 py-3 font-title text-sm font-bold
               text-black transition-colors hover:bg-terracotta-800 hover:text-paper
               sm:flex-1"
      >Minden mérés engedélyezése</button>
      <button
        type="button" id="c-customize"
        class="rounded-brand px-5 py-3 font-title text-sm font-bold text-black
               ring-1 ring-inset ring-black/20 transition-colors hover:bg-black/5 sm:flex-1"
      >Testreszabás ›</button>
    </div>
  </div>
</div>

<script>
  type Consent = { analytics: boolean; marketing: boolean; ts: number };
  const KEY = 'bm-consent';

  const el = document.getElementById('consent')!;
  const analyticsBox = document.getElementById('c-analytics') as HTMLInputElement;
  const marketingBox = document.getElementById('c-marketing') as HTMLInputElement;
  const customize = document.getElementById('c-customize') as HTMLButtonElement;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.c-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  const read = (): Consent | null => {
    try {
      const raw = localStorage.getItem(KEY);
      return raw ? (JSON.parse(raw) as Consent) : null;
    } catch {
      return null;
    }
  };

  /* The customise button becomes the save button once the categories are on
     screen — the same place on screen keeps doing the obvious next thing. */
  function openTab(name: string) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', String(on));
      t.classList.toggle('border-black', on);
      t.classList.toggle('text-black', on);
      t.classList.toggle('border-transparent', !on);
      t.classList.toggle('text-black/55', !on);
    });
    panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== name));
    customize.textContent = name === 'details' ? 'Kiválasztottak engedélyezése' : 'Testreszabás ›';
  }

  function apply(c: Consent) {
    const g = (window as any).gtag;
    if (typeof g === 'function') {
      g('consent', 'update', {
        ad_storage: c.marketing ? 'granted' : 'denied',
        ad_user_data: c.marketing ? 'granted' : 'denied',
        ad_personalization: c.marketing ? 'granted' : 'denied',
        analytics_storage: c.analytics ? 'granted' : 'denied',
      });
    }
    const fbq = (window as any).fbq;
    if (typeof fbq === 'function' && c.marketing) {
      fbq('consent', 'grant');
      fbq('track', 'PageView');
    }
    // Lets GTM fire tags that were held back while consent was denied.
    (window as any).dataLayer?.push({ event: 'consent_update', bm_consent: c });
  }

  function save(analytics: boolean, marketing: boolean) {
    const c: Consent = { analytics, marketing, ts: Date.now() };
    try {
      localStorage.setItem(KEY, JSON.stringify(c));
    } catch { /* storage blocked — honour the choice for this page view only */ }
    apply(c);
    hide();
  }

  function show() {
    el.classList.remove('hidden');
    el.classList.add('flex');
    // A dialog over a page that still scrolls behind it reads as broken.
    document.documentElement.style.overflow = 'hidden';
    (document.getElementById('c-accept') as HTMLButtonElement).focus();
  }

  function hide() {
    el.classList.add('hidden');
    el.classList.remove('flex');
    document.documentElement.style.overflow = '';
  }

  document.getElementById('c-accept')!.addEventListener('click', () => save(true, true));
  document.getElementById('c-reject')!.addEventListener('click', () => save(false, false));

  customize.addEventListener('click', () => {
    const onDetails = !document.querySelector<HTMLElement>('[data-panel="details"]')!
      .classList.contains('hidden');
    if (onDetails) save(analyticsBox.checked, marketingBox.checked);
    else openTab('details');
  });

  tabs.forEach((t) => t.addEventListener('click', () => openTab(t.dataset.tab!)));

  /* Focus stays inside while the dialog is open. There is no dismiss: a
     consent dialog that can be closed without choosing leaves the visitor in
     the denied default forever without ever being asked again. */
  el.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = el.querySelectorAll<HTMLElement>(
      'button, a[href], input:not([disabled])',
    );
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // Footer link reopens the dialog with current choices pre-filled.
  document.querySelectorAll('[data-consent-reopen]').forEach((b) =>
    b.addEventListener('click', () => {
      const c = read();
      analyticsBox.checked = c?.analytics ?? false;
      marketingBox.checked = c?.marketing ?? false;
      openTab('details');
      show();
    }),
  );

  if (!read()) show();
</script>
