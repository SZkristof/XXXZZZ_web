---
import SectionHeading from '@/components/SectionHeading.astro';
import { services } from '@/data/site';

/**
 * Six entry points, two-up on phones by request. Two columns on a 360px screen
 * leaves roughly 150px of text width, which the full Hungarian descriptions
 * cannot survive — so each tile carries a one-line `short` for mobile and the
 * full body from sm upward. Nothing is truncated mid-sentence; the two copies
 * are authored, not clipped.
 *
 * The tile itself is the link (whole-card target), and the visible CTA is a
 * styled span rather than a nested <a>, because an anchor inside an anchor is
 * invalid HTML and breaks keyboard order.
 */
---

<section class="section" data-theme="shared" id="szolgaltatasok">
  <div class="container-x">
    <SectionHeading
      eyebrow="SZOLGÁLTATÁSOK"
      title="Valós megoldások vállalkozásodra szabva"
      lead="Lépésről lépésre vezetlek végig a sikeres hirdetéskészítés folyamatain, hogy ne csak égesd a pénzt."
      align="center"
    />

    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3">
      {services.map((s, i) => (
        <li class="contents">
          <a
            href={s.href}
            data-track={`service-${s.id}`}
            class="group card flex h-full flex-col p-4 transition-all duration-300 ease-out
                   hover:-translate-y-1 hover:shadow-shade-lift focus-visible:-translate-y-1
                   sm:p-6 lg:p-7"
          >
            <span class="font-title text-xs font-bold tracking-widest text-black/40
                         transition-colors group-hover:text-terracotta-800">
              0{i + 1}
            </span>

            <h3 class="mt-3 font-title text-[15px] font-bold leading-snug tracking-tight text-black
                       sm:mt-4 sm:text-lg lg:text-xl">
              {s.name}
            </h3>

            <!-- Phone: one authored line. -->
            <p class="mt-2 flex-1 text-[13px] leading-[1.45] text-black/72 sm:hidden">
              {s.short}
            </p>
            <!-- Tablet and up: the full description. -->
            <p class="mt-4 hidden flex-1 text-[0.9375rem] leading-relaxed text-black/72 sm:block">
              {s.body}
            </p>

            <span
              class:list={[
                'mt-4 inline-flex items-center gap-1.5 font-title text-[13px] font-bold sm:mt-6 sm:gap-2 sm:text-[0.9375rem]',
                s.tone === 'blue' ? 'text-blue-800' : 'text-terracotta-800',
              ]}
            >
              {s.cta}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1.5">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
