---
import SectionHeading from '@/components/SectionHeading.astro';
import { results, PROOF_IS_PLACEHOLDER } from '@/data/proof';
import { expert } from '@/data/site';
import { num } from '@/lib/format';
---

<section class="section bg-white" id="eredmenyek">
  <div class="container-x">
    <SectionHeading
      eyebrow="Eredmények"
      title="Számok, nem jelzők"
      lead="Az ügyfeleim a saját fiókjukban dolgoznak, ezért az eredmény is az övék marad. Néhány jellemző eset — iparág és cégméret megjelölve, névtelenül."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {results.map((r) => (
        <figure class="flex flex-col rounded-2xl border border-ink-200 bg-white p-7 shadow-soft">
          <figcaption class="flex items-center justify-between gap-3">
            <span class="font-display text-sm font-bold text-ink-950">{r.industry}</span>
            <span class="shrink-0 rounded-md bg-ink-100 px-2 py-0.5 text-xs font-medium text-ink-600">
              {r.size}
            </span>
          </figcaption>

          <p class="mt-1 text-sm text-ink-500">{r.platform}</p>

          <p class="mt-7 text-xs font-semibold uppercase tracking-wider text-ink-500">
            {r.metric}
          </p>
          <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-display text-xl font-bold text-ink-400 line-through decoration-ink-300">
              {r.from}
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="shrink-0 text-ink-400">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="font-display text-3xl font-extrabold text-signal-600">{r.to}</span>
          </div>

          <p class="mt-3 text-sm font-medium text-ink-900">{r.timeframe} alatt</p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{r.note}</p>
        </figure>
      ))}
    </div>

    {PROOF_IS_PLACEHOLDER && (
      <p class="mt-6 rounded-lg border border-dashed border-ember-300 bg-ember-50 px-4 py-3 text-sm text-ember-900">
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> a fenti adatok
        kitaláltak, csak a tördelés bemutatására szolgálnak. Valós adatokra cserélendők a
        <code class="font-mono">src/data/proof.ts</code> fájlban.
      </p>
    )}

    <!-- Credibility stats -->
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-ink-200 md:grid-cols-4">
      {[
        { n: `${num(expert.businessesTrained)}+`, l: 'képzett vállalkozás' },
        { n: `${expert.yearsExperience} év`, l: 'a szakmában' },
        { n: '3', l: 'platform: Meta, Google, LinkedIn' },
        { n: '60 perc', l: 'egy alkalom, egyénileg' },
      ].map((s) => (
        <div class="bg-white px-5 py-8 text-center">
          <dt class="sr-only">{s.l}</dt>
          <dd>
            <span class="block font-display text-3xl font-extrabold tracking-tight text-ink-950">
              {s.n}
            </span>
            <span class="mt-2 block text-sm leading-snug text-ink-600">{s.l}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
