---
import SectionHeading from '@/components/SectionHeading.astro';
import { results, PROOF_IS_PLACEHOLDER } from '@/data/proof';
import { expert } from '@/data/site';
import { num } from '@/lib/format';
---

<section class="section ground-paper" id="eredmenyek">
  <div class="container-x">
    <SectionHeading
      eyebrow="EREDMÉNYEK"
      title="Számok, nem jelzők"
      lead="Az ügyfeleim a saját fiókjukban dolgoznak, ezért az eredmény is az övék marad. Néhány jellemző eset — iparág és cégméret megjelölve, névtelenül."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {results.map((r) => (
        <figure class="flex flex-col card p-7 shadow-shade">
          <figcaption class="flex items-center justify-between gap-3">
            <span class="font-title text-sm font-bold text-black">{r.industry}</span>
            <span class="shrink-0 rounded-brand bg-black/5 px-2 py-0.5 text-xs font-medium text-black/72">
              {r.size}
            </span>
          </figcaption>

          <p class="mt-1 text-sm text-black/65">{r.platform}</p>

          <p class="mt-7 text-xs font-semibold uppercase tracking-wider text-black/65">
            {r.metric}
          </p>
          <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-title text-xl font-bold text-paper/75 line-through decoration-black/30">
              {r.from}
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="shrink-0 text-paper/75">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="font-title text-3xl font-bold text-signal">{r.to}</span>
          </div>

          <p class="mt-3 text-sm font-medium text-black">{r.timeframe} alatt</p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-black/72">{r.note}</p>
        </figure>
      ))}
    </div>

    {PROOF_IS_PLACEHOLDER && (
      <p class="mt-6 rounded-brand border border-dashed border-terracotta-500/40 bg-terracotta-200/40 px-4 py-3 text-sm text-terracotta-800">
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> a fenti adatok
        kitaláltak, csak a tördelés bemutatására szolgálnak. Valós adatokra cserélendők a
        <code class="font-mono">src/data/proof.ts</code> fájlban.
      </p>
    )}

    <!-- Credibility stats -->
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-brand bg-black/10 md:grid-cols-4">
      {[
        { n: `${num(expert.businessesTrained)}+`, l: 'képzett vállalkozás' },
        { n: `${expert.yearsExperience} év`, l: 'a szakmában' },
        { n: '3', l: 'platform: Meta, Google, LinkedIn' },
        { n: '60 perc', l: 'egy alkalom, egyénileg' },
      ].map((s) => (
        <div class="bg-white px-5 py-8 text-center">
          <dt class="sr-only">{s.l}</dt>
          <dd>
            <span class="block font-title text-3xl font-bold tracking-tight text-black">
              {s.n}
            </span>
            <span class="mt-2 block text-sm leading-snug text-black/72">{s.l}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
