---
import SectionHeading from '@/components/SectionHeading.astro';
import { results, PROOF_IS_PLACEHOLDER, type Half } from '@/data/proof';
import { expert } from '@/data/site';
import { num } from '@/lib/format';

interface Props {
  /** Show only the results one half produced. An agency page arguing with
   *  coaching results would be claiming credit for work the client did. */
  half?: Half;
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** The credibility figures belong to the business as a whole, so they are
   *  off by default on a page scoped to one half. */
  stats?: boolean;
}
const {
  half,
  eyebrow = 'EREDMÉNYEK',
  title = 'Mások már megtanulták, te készen állsz?',
  lead = 'Szeretnék megosztani Veled pár eredményt korábbi ügyfeleimtől, hogy lásd, mire számíthatsz.',
  stats = true,
} = Astro.props;

const shown = half ? results.filter((r) => r.half === half) : results;

// The grid follows the data so an honest, short list never reads as a gap —
// and an even count goes two-up rather than leaving one card stranded on a
// second row of three.
const resultCols =
  shown.length >= 5 ? 'md:grid-cols-3'
  : shown.length === 4 ? 'sm:grid-cols-2 mx-auto max-w-5xl'
  : shown.length === 3 ? 'md:grid-cols-3'
  : shown.length === 2 ? 'sm:grid-cols-2 mx-auto max-w-3xl'
  : 'mx-auto max-w-md';
---

<section class="section" data-theme="shared" id="eredmenyek">
  <div class="container-x">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      lead={lead}
    />

    <div class:list={['mt-14 grid gap-5', resultCols]}>
      {shown.map((r) => (
        <figure class="flex flex-col card p-7 shadow-shade">
          <figcaption class="flex items-center justify-between gap-3">
            <span class="font-title text-sm font-bold text-black">{r.industry}</span>
            {r.size && (
              <span class="shrink-0 rounded-brand bg-black/5 px-2 py-0.5 text-xs font-medium text-black/72">
                {r.size}
              </span>
            )}
          </figcaption>

          <p class="mt-1 text-sm text-black/65">{r.platform}</p>

          <p class="mt-7 text-xs font-semibold uppercase tracking-wider text-black/65">
            {r.metric}
          </p>
          <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            {r.from && (
              <Fragment>
                <span class="font-title text-xl font-bold text-black/45 line-through decoration-black/30">
                  {r.from}
                </span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                  class="shrink-0 text-black/45">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </Fragment>
            )}
            <span class="font-title text-3xl font-bold text-signal">{r.to}</span>
          </div>

          <!-- Some timeframes are a duration ("15 nap"), some are a condition
               ("napi 700 Ft keretből"). Only the first takes "alatt". -->
          <p class="mt-3 text-sm font-medium text-black">
            {/\d/.test(r.timeframe.trim()[0] ?? '') ? `${r.timeframe} alatt` : r.timeframe}
          </p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-black/72">{r.note}</p>
        </figure>
      ))}
    </div>

    {PROOF_IS_PLACEHOLDER && (
      <p class="mt-6 rounded-brand bg-terracotta-200 px-4 py-3 text-sm text-terracotta-800">
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> a fenti adatok
        kitaláltak, csak a tördelés bemutatására szolgálnak. Valós adatokra cserélendők a
        <code class="font-mono">src/data/proof.ts</code> fájlban.
      </p>
    )}

    <!-- Credibility stats, as the brand book's stat: a figure standing beside
         one slab at cap height. The slab is the mark's own shape, which is
         why the figures no longer need a boxed grid to read as a set. -->
    {stats && (
    <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
      {[
        { n: `${num(expert.businessesTrained)}+`, l: 'képzett vállalkozás' },
        { n: `${expert.yearsExperience} év`, l: 'szakmai tapasztalat' },
        { n: '3', l: 'platform: Meta, Google, LinkedIn' },
        { n: '100%', l: 'elégedettség' },
      ].map((s) => (
        <div>
          <dt class="sr-only">{s.l}</dt>
          <dd class="bm-stat">
            <!-- One slab of the mark: width 0.24 of its height, sheared by
                 0.2309 of it. Both ratios measured off A Vágás's middle
                 slab, which is the one the mark does not crop. -->
            <svg class="sl" viewBox="0 0 25.43 54" aria-hidden="true">
              <path d="M12.47 0 H25.43 L12.96 54 H0 Z" />
            </svg>
            <div>
              <b class="block text-black">{s.n}</b>
              <span class="block text-black/72">{s.l}</span>
            </div>
          </dd>
        </div>
      ))}
    </dl>
    )}
  </div>
</section>
