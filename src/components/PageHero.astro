---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-56 left-1/2 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full
             bg-[radial-gradient(circle,rgba(255,90,31,0.20),transparent_62%)] blur-2xl"
    >
    </div>
  </div>
  <div class="container-x relative">
    <div class="max-w-3xl py-16 sm:py-20 lg:py-24">
      {eyebrow && <p class="eyebrow text-ember-400">{eyebrow}</p>}
      <h1 class:list={['text-5xl font-extrabold text-white', eyebrow && 'mt-4']}>
        {title}
      </h1>
      {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300">{lead}</p>}
    </div>
  </div>
</section>
