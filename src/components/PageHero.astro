---
import Slabs from '@/components/Slabs.astro';

interface Props {
  /** Authored in UPPERCASE — never text-transform. */
  eyebrow?: string;
  title: string;
  lead?: string;
  /**
   * Which half of the business this page belongs to. Colour is the only thing
   * that separates them, so it has to be deliberate — and under Round 6 the
   * mode IS the meaning:
   *   agency   → blue-800 ground, type paper (9.55:1)
   *   coaching → terracotta-500 ground, type BLACK (5.19:1), never blue
   * A page belonging to neither half takes 'shared' and gets the slab triplet
   * instead of a colour, so it still opens with weight.
   */
  mode?: 'agency' | 'coaching' | 'shared';
}
const { eyebrow, title, lead, mode = 'agency' } = Astro.props;
const dark = mode === 'agency';
---
<section data-theme={mode} class="relative overflow-hidden">
  {mode === 'shared' && <Slabs group="triplet" />}
  <div class="container-x relative z-10 py-16 lg:py-24">
    <div class="max-w-[52rem]">
      {eyebrow && (
        <p class:list={['t-label', dark ? 'text-terracotta-200' : 'text-highlight']}>{eyebrow}</p>
      )}
      <h1 class:list={['t-display', eyebrow && 'mt-4', dark ? 'text-paper' : 'text-black']}>
        {title}
      </h1>
      {lead && (
        <p class:list={['t-lead mt-6 max-w-[56ch]', dark ? 'text-paper/85' : 'text-black/80']}>
          {lead}
        </p>
      )}
    </div>
  </div>
</section>
