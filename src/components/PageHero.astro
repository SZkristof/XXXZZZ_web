---
interface Props {
  /** Authored in UPPERCASE — never text-transform. */
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<!-- Blue-800 ground: type is paper (8.32:1), accents terracotta-200 (5.85:1). -->
<section class="ground-blue">
  <div class="container-x py-16 lg:py-24">
    <div class="max-w-[52rem]">
      {eyebrow && <p class="t-label text-terracotta-200">{eyebrow}</p>}
      <h1 class:list={['t-display text-paper', eyebrow && 'mt-4']}>{title}</h1>
      {lead && <p class="t-lead mt-6 max-w-[56ch] text-paper/85">{lead}</p>}
    </div>
  </div>
</section>
