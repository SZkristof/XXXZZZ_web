---
import SectionHeading from '@/components/SectionHeading.astro';
import { tracks } from '@/data/site';
---

<!-- Self-identification before selling. Most visitors don't know what to buy;
     they only know what's wrong. Let them pick the symptom. -->
<section class="section bg-white" id="hol-tartasz">
  <div class="container-x">
    <SectionHeading
      eyebrow="Hol tartasz most?"
      title="Válaszd ki, melyik mondat a tiéd"
      lead="Nem ugyanazt tanítom annak, aki még el se indult, és annak, aki már két ügynökségen van túl. Kattints arra, ami rád illik."
      align="center"
    />

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {tracks.map((t, i) => (
        <a
          href={`/programok#${t.slug}`}
          class="group relative flex flex-col rounded-2xl border border-ink-200 bg-white p-7
                 transition-all duration-300 ease-out hover:-translate-y-1
                 hover:border-ember-300 hover:shadow-lift focus-visible:-translate-y-1"
        >
          <span
            class="font-display text-xs font-extrabold tracking-widest text-ink-300
                   transition-colors group-hover:text-ember-400"
          >
            0{i + 1}
          </span>

          <p class="mt-5 font-display text-xl font-bold leading-snug text-ink-950">
            „{t.symptom}"
          </p>

          <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">
            {t.description}
          </p>

          <span
            class="mt-7 inline-flex items-center gap-2 font-display text-[0.9375rem]
                   font-bold text-ember-700"
          >
            {t.label}
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="transition-transform duration-300 ease-out group-hover:translate-x-1.5">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
