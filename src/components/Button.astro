---
/**
 * Brand rule: the 500 steps are FILLS, never type.
 *   - terracotta fill carries BLACK text (5.19:1)
 *   - blue-800 fill carries PAPER (8.32:1)
 *   - signal fill carries WHITE (5.67:1)
 * Never blue on terracotta or terracotta on blue: both are 2.79:1.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'dark' | 'outline' | 'onDark' | 'signal';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  track?: string;
  [key: string]: unknown;
}

const {
  href, variant = 'primary', size = 'md',
  class: className = '', type = 'button', track, ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-brand font-title ' +
  'font-bold text-center transition-[transform,background-color,box-shadow] duration-200 ' +
  'disabled:pointer-events-none disabled:opacity-50';

const variants = {
  primary: 'bg-terracotta-500 text-black shadow-shade hover:-translate-y-px hover:shadow-shade-lift',
  dark:    'bg-blue-800 text-paper shadow-shade hover:-translate-y-px hover:shadow-shade-lift',
  signal:  'bg-signal text-white shadow-shade hover:-translate-y-px hover:shadow-shade-lift',
  outline: 'bg-transparent text-black ring-1 ring-inset ring-black/25 hover:ring-black/60',
  onDark:  'bg-transparent text-paper ring-1 ring-inset ring-paper/35 hover:bg-paper/10 hover:ring-paper/60',
};

const sizes = {
  sm: 'px-4 py-2 text-[15px]',
  md: 'px-5 py-3 text-[17px]',
  lg: 'px-7 py-4 text-[18px]',
};

const cls = [base, variants[variant], sizes[size], className].join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag class={cls} {...href ? { href } : { type }} {...track ? { 'data-track': track } : {}} {...rest}>
  <slot />
</Tag>
