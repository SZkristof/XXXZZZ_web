---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'onDark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  /** Marks this as the booking CTA so conversions can be attributed. */
  track?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  track,
  ...rest
} = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 rounded-lg font-display ' +
  'font-bold tracking-tight transition-all duration-200 ease-out ' +
  'disabled:pointer-events-none disabled:opacity-50 text-center';

const variants = {
  primary:
    'bg-ember-500 text-white shadow-[0_1px_0_rgba(255,255,255,0.25)_inset,0_6px_20px_-6px_rgba(255,90,31,0.7)] ' +
    'hover:bg-ember-600 hover:-translate-y-0.5 hover:shadow-[0_1px_0_rgba(255,255,255,0.25)_inset,0_12px_28px_-8px_rgba(255,90,31,0.8)] active:translate-y-0',
  secondary:
    'bg-ink-950 text-white hover:bg-ink-800 hover:-translate-y-0.5 shadow-soft active:translate-y-0',
  ghost:
    'bg-transparent text-ink-900 ring-1 ring-inset ring-ink-200 hover:ring-ink-400 hover:bg-ink-50',
  onDark:
    'bg-white/10 text-white ring-1 ring-inset ring-white/25 backdrop-blur hover:bg-white/20 hover:ring-white/40',
};

const sizes = {
  sm: 'px-4 py-2.5 text-sm',
  md: 'px-5 py-3 text-[0.9375rem]',
  lg: 'px-7 py-4 text-base sm:text-lg',
};

const cls = [base, variants[variant], sizes[size], className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag
  class={cls}
  {...href ? { href } : { type }}
  {...track ? { 'data-track': track } : {}}
  {...rest}
>
  <slot />
</Tag>
