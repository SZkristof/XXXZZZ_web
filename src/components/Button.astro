---
/**
 * The brand's button: a 13° cut right end, the same lean as the mark, with
 * the left corners keeping the one 4px rounding. The 10px pill that briefly
 * lived here is gone — Round 6 gives the button a distinguishing shape
 * instead of a second radius.
 *
 * Colour is never named at a call site. It comes from the section's mode
 * through the `action` / `on-action` roles, which means the same markup is
 * terracotta-on-linen in a shared section, blue-on-terracotta in a coaching
 * one, and terracotta-on-blue in an agency one — each pairing already
 * verified by the brand book.
 *
 * On a shared ground the terracotta fill sits 2.91:1 against the linen, under
 * the 3:1 floor for a component boundary, so the CSS gives it a 1px
 * terracotta-800 edge (6.35:1). That rule lives in global.css, not here, so a
 * white card gets it too.
 *
 * The shade is a drop-shadow filter on the wrapper: box-shadow is clipped
 * away by clip-path, so it has to sit on the element above the cut.
 */
interface Props {
  href?: string;
  /**
   * 'action' takes the section's action colour. 'light' is the white button
   * for a coloured ground where a second action fill would compete.
   */
  variant?: 'action' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  track?: string;
  [key: string]: unknown;
}

const {
  href, variant = 'action', size = 'md',
  class: className = '', type = 'button', track, ...rest
} = Astro.props;

const cls = [
  'bm-btn',
  variant === 'light' && 'bm-btn--light',
  size === 'sm' && 'bm-btn--sm',
  size === 'lg' && 'bm-btn--lg',
  className,
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'button';
---
<Tag class={cls} {...href ? { href } : { type }} {...track ? { 'data-track': track } : {}} {...rest}>
  <span><slot /></span>
</Tag>
