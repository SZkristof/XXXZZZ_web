---
import { site, nav, contact, expert, platforms } from '@/data/site';
import Logo from '@/components/Logo.astro';
const year = new Date().getFullYear();

const legal = [
  { href: '/adatkezeles', label: 'Adatkezelési tájékoztató' },
  { href: '/aszf', label: 'ÁSZF' },
  { href: '/cookie', label: 'Cookie tájékoztató' },
];
---

<footer class="border-t border-black/20 bg-blue-800 text-paper/85">
  <div class="container-x">
    <!-- Final CTA -->
    <div class="border-b border-white/10 py-14 sm:py-20">
      <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
        <div>
          <h2 class="max-w-2xl text-3xl text-white sm:text-4xl">
            Beszéljünk 30 percet arról, hol tartasz most.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-paper/75">
            Ingyenes, és nem kell rá készülnöd. Megnézzük, mivel foglalkozol, mire költesz
            most, és megmondom őszintén, tudok-e segíteni — vagy nem.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a
            href="/kapcsolat"
            data-track="footer-cta"
            class="inline-flex flex-1 items-center justify-center rounded-brand bg-terracotta-500 px-6 py-4
                   font-title text-base font-bold text-black transition-all duration-200
                   hover:-translate-y-0.5 hover:bg-terracotta-800"
          >
            Időpontot foglalok
          </a>
          <a
            href={`tel:${contact.phoneHref}`}
            class="inline-flex flex-1 items-center justify-center rounded-brand px-6 py-4
                   font-title text-base font-bold text-white ring-1 ring-inset ring-white/25
                   transition-colors hover:bg-white/10"
          >
            {contact.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4 lg:py-16">
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo variant="lockup" size={19} class="text-paper" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/75">
          Egyéni hirdetési képzés magyar kis- és középvállalkozásoknak. A saját kampányaidat
          építed — csak nem egyedül.
        </p>
        <p class="mt-4 text-sm text-black/65">
          {expert.name} · {expert.yearsExperience} év a szakmában
        </p>
      </div>

      <nav aria-labelledby="f-nav">
        <h3 id="f-nav" class="t-label text-black/65">Oldalak</h3>
        <ul class="mt-4 space-y-2.5">
          {nav.map((i) => (
            <li>
              <a href={i.href} class="text-sm text-paper/85 transition-colors hover:text-terracotta-200">
                {i.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/kapcsolat" class="text-sm text-paper/85 transition-colors hover:text-terracotta-200">
              Kapcsolat
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="f-plat">
        <h3 id="f-plat" class="t-label text-black/65">Platformok</h3>
        <ul class="mt-4 space-y-2.5">
          {platforms.map((p) => (
            <li>
              <a
                href={`/kepzes#${p.id}`}
                class="text-sm text-paper/85 transition-colors hover:text-terracotta-200"
              >
                {p.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="t-label text-black/65">Elérhetőség</h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="text-sm text-paper/85 transition-colors hover:text-terracotta-200"
            >{contact.email}</a>
          </li>
          <li>
            <a
              href={`tel:${contact.phoneHref}`}
              class="text-sm text-paper/85 transition-colors hover:text-terracotta-200"
            >{contact.phone}</a>
          </li>
        </ul>
        <h3 class="t-label mt-8 text-black/65">Jogi</h3>
        <ul class="mt-4 space-y-2.5">
          {legal.map((i) => (
            <li>
              <a href={i.href} class="text-sm text-paper/85 transition-colors hover:text-terracotta-200">
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-white/10 py-7 text-sm text-black/65 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}. Minden jog fenntartva.</p>
      <button
        type="button"
        data-consent-reopen
        class="text-left underline underline-offset-4 transition-colors hover:text-paper/85 sm:text-right"
      >
        Cookie beállítások
      </button>
    </div>
  </div>
</footer>
