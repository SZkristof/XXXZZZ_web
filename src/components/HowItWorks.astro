---
import SectionHeading from '@/components/SectionHeading.astro';
import { SESSION_LENGTH_MIN } from '@/data/site';

/**
 * Shared mode, where the brand book has both colours available as accents:
 * terracotta marks coaching items, blue marks agency items. These steps are
 * the coaching process, so the markers are terracotta-500 carrying black
 * (5.19:1) — they were blue, which quietly filed the coaching process under
 * the agency half. Hover deepens the ring rather than swapping the type
 * colour, so the number never changes contrast mid-interaction.
 */
const steps = [
  {
    title: 'Ingyenes 30 perces konzultáció',
    body: 'Elmondod, mivel foglalkozol és hol tartasz. Megmondom, hogyan tudok segíteni.',
  },
  {
    title: 'Irányválasztás',
    body: 'Meta, Google vagy LinkedIn — és hány alkalom kell hozzá. Pont azt kapod, amire szükséged van. Nem többet, nem kevesebbet!',
  },
  {
    title: 'Első óra: képernyőmegosztás, közös munka',
    body: `Nem diákat nézünk. ${SESSION_LENGTH_MIN} percen át megosztod a képernyőd, és együtt dolgozunk a saját hirdetési fiókodban, a saját termékeiden vagy szolgáltatásodon.`,
  },
  {
    title: 'Hirdetések indítása és optimalizálása',
    body: 'Élesben indulnak a kampányok, nem tesztkörnyezetben. Aztán együtt optimalizáljuk őket, amíg futnak.',
  },
  {
    title: 'Eredmények elemzése',
    body: 'Átnézzük a számokat: mi hozott eredményt, mi nem, és mire megy el a büdzsé. Megtanulod, mit kell nézned hetente, és mikor kell hozzányúlni a hirdetéshez.',
  },
  {
    title: 'Tanfolyam-felvételek — nem kell jegyzetelned',
    body: 'Minden alkalomról videófelvétel készül, amit az óra után megkapsz. Bármikor visszanézheted, ingyen.',
  },
];

const facts = [
  { k: 'Alkalmanként', v: '60 perc', wide: false },
  { k: 'Hetente max.', v: '2 alkalom', wide: false },
  { k: 'Helyszín', v: 'Online (Google Meet) vagy személyesen Budapesten', wide: true },
  { k: 'Visszanézhető', v: 'Igen — ingyenes felvétel', wide: true },
];
---

<section class="section" data-theme="shared" id="hogyan">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          title="Hogyan működik?"
          lead="Nincs tananyag, nincs házifeladat, csak Te, az Oktatód és a vállalkozásod. Szuperintenzív marketing tanfolyam, 100% gyakorlattal, mellébeszélés nélkül."
        />
        <dl class="mt-9 grid grid-cols-2 gap-3 sm:gap-5">
          {facts.map((f) => (
            <div class:list={['card p-5', f.wide && 'col-span-2']}>
              <dt class="t-label text-black/65">{f.k.toUpperCase()}</dt>
              <dd class:list={[
                'mt-1.5 font-title font-bold text-black',
                f.wide ? 'text-lg leading-snug' : 'text-2xl',
              ]}>{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <ol class="relative space-y-1">
        {steps.map((s, i) => (
          <li class="group relative flex gap-5 pb-8 last:pb-0 sm:gap-7">
            <div class="relative flex flex-col items-center">
              <span
                class="z-10 grid h-11 w-11 shrink-0 place-items-center rounded-brand
                       bg-terracotta-500 font-title text-sm font-bold text-black
                       ring-4 ring-paper transition-shadow duration-300
                       group-hover:shadow-[0_0_0_2px_var(--color-terracotta-800)]"
              >
                {i + 1}
              </span>
              {i < steps.length - 1 && (
                <span class="absolute top-11 h-full w-px bg-black/10" aria-hidden="true"></span>
              )}
            </div>
            <div class="pt-1.5">
              <h3 class="font-title text-xl font-bold leading-snug tracking-tight text-black">
                {s.title}
              </h3>
              <p class="mt-2 max-w-lg leading-relaxed text-black/72">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
