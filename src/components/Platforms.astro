---
import SectionHeading from '@/components/SectionHeading.astro';
import { platforms } from '@/data/site';
---

<section class="section ground-paper" id="platformok">
  <div class="container-x">
    <SectionHeading
      eyebrow="PLATFORMOK"
      title="Egyet választasz — vagy kettőt kombinálunk"
      lead="Nem kell mindenhol ott lenned. Az első alkalmon eldöntjük, hol van a te vevőd, és arra koncentrálunk."
      align="center"
    />

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {platforms.map((p) => (
        <article id={p.id} class="scroll-mt-28 card p-7">
          <h3 class="font-title text-xl font-bold tracking-tight text-black">
            {p.name}
          </h3>
          <p class="mt-1 text-sm text-black/65" set:html={p.sub} />
          <p class="mt-5 border-t border-black/10 pt-5 leading-relaxed text-black/72">
            {p.bestFor}
          </p>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-black/72">
      A 10 alkalmas csomagban két platform fér el — a leggyakoribb páros a
      <strong class="font-semibold text-black">Meta + Google</strong>.
    </p>
  </div>
</section>
