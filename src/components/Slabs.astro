---
/**
 * The one graphic shape: a slab of the mark. A 13° parallelogram whose width
 * is 0.24 of its height.
 *
 * The brand book's limits, enforced here rather than left to call sites:
 *   - one slab or the triplet per surface, never more than three
 *   - one colour per group
 *   - entering from an edge and cropped by it
 *   - NEVER behind text
 *
 * The last one is the reason this renders into an absolutely positioned layer
 * at z-0 while the content around it sits at z-10: the slabs stay in the
 * margin of a section, not under its words. The parent must be `relative
 * overflow-hidden` so the crop happens at the section edge.
 *
 * It is ground, not a raised shape, so it takes no shade and no rounding, and
 * it is aria-hidden — it carries no meaning a screen reader should announce.
 */
interface Props {
  /** 'single' is one slab; 'triplet' is the mark's slab-cut-slab-cut-slab. */
  group?: 'single' | 'triplet';
  /** Which edge the slabs enter from. */
  from?: 'right' | 'left';
  /** Slab height. Width follows at 0.24 of it. */
  height?: string;
  /** Any scale colour, or a role token. One colour per group. */
  color?: string;
  opacity?: number;
  class?: string;
}
const {
  group = 'single',
  from = 'right',
  height = '340px',
  color = 'var(--color-black)',
  opacity = 0.07,
  class: className = '',
} = Astro.props;

/* Offsets are measured from the entry edge. The triplet keeps the mark's own
   rhythm — the gaps are wider than the slabs, as in A Vágás. */
const offsets = group === 'triplet' ? ['-2%', '7%', '16%'] : ['-2%'];
---
<div
  class:list={['bm-slabs', className]}
  style={`--slab-h:${height};--slab-color:${color};--slab-opacity:${opacity}`}
  aria-hidden="true"
>
  {offsets.map((o) => (
    <i style={from === 'right' ? `right:${o};top:-8%` : `left:${o};top:-8%`}></i>
  ))}
</div>
