---
import SectionHeading from '@/components/SectionHeading.astro';
import { testimonials, PROOF_IS_PLACEHOLDER } from '@/data/proof';
---

<section class="section bg-ink-50" id="velemenyek">
  <div class="container-x">
    <SectionHeading
      eyebrow="Vélemények"
      title="Mit mondanak azok, akik végigcsinálták"
      align="center"
    />

    <div class="mt-14 columns-1 gap-5 md:columns-2 lg:columns-2 [&>*]:mb-5">
      {testimonials.map((t) => (
        <figure class="break-inside-avoid rounded-2xl border border-ink-200 bg-white p-7 shadow-soft">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            class="text-ember-300">
            <path d="M9.5 5C6.46 5 4 7.46 4 10.5c0 2.76 2.02 5.05 4.66 5.44-.2 1.3-1.1 2.4-2.4 2.86a.6.6 0 0 0 .2 1.17c3.3-.3 6.54-3.3 6.54-8.47V10.5C13 7.46 12.54 5 9.5 5zm9 0C15.46 5 13 7.46 13 10.5c0 2.76 2.02 5.05 4.66 5.44-.2 1.3-1.1 2.4-2.4 2.86a.6.6 0 0 0 .2 1.17c3.3-.3 6.54-3.3 6.54-8.47V10.5C22 7.46 21.54 5 18.5 5z"/>
          </svg>

          <blockquote class="mt-4">
            <p class="text-[1.0625rem] leading-relaxed text-ink-800">{t.quote}</p>
          </blockquote>

          <figcaption class="mt-6 flex items-center gap-3.5 border-t border-ink-100 pt-5">
            <span
              class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink-950
                     font-display text-sm font-extrabold text-white"
              aria-hidden="true"
            >{t.initials}</span>
            <span class="min-w-0">
              <span class="block font-display text-[0.9375rem] font-bold text-ink-950">
                {t.name}
              </span>
              <span class="block truncate text-sm text-ink-500">
                {t.role} · {t.company}
              </span>
            </span>
            <span
              class="ml-auto hidden shrink-0 rounded-md bg-ember-50 px-2.5 py-1 text-xs
                     font-semibold text-ember-800 sm:block"
            >{t.track}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {PROOF_IS_PLACEHOLDER && (
      <p class="mt-2 rounded-lg border border-dashed border-ember-300 bg-ember-50 px-4 py-3 text-sm text-ember-900">
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> ezek kitalált
        vélemények, a tördelés bemutatására. Valós, engedélyezett véleményekre cserélendők a
        <code class="font-mono">src/data/proof.ts</code> fájlban.
      </p>
    )}
  </div>
</section>
