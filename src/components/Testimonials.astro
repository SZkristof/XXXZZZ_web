---
import SectionHeading from '@/components/SectionHeading.astro';
import { testimonials, PROOF_IS_PLACEHOLDER } from '@/data/proof';

const HALF_LABEL = { kepzes: 'Képzés', ugynokseg: 'Ügynökség' } as const;

// Two columns need at least two quotes to balance; one quote centres instead.
const quoteCols =
  testimonials.length >= 2 ? 'columns-1 md:columns-2' : 'columns-1 mx-auto max-w-2xl';
---

<section class="section" data-theme="shared" id="velemenyek">
  <div class="container-x">
    <SectionHeading
      eyebrow="VÉLEMÉNYEK"
      title="Mit mondanak az ügyfeleim"
      align="center"
    />

    <div class:list={['mt-14 gap-5 [&>*]:mb-5', quoteCols]}>
      {testimonials.map((t) => (
        <figure class="break-inside-avoid card p-7 shadow-shade">
          <!-- The brand's own quote mark: the ű's two 13° bars, not a
               generic typographic glyph. -->
          <svg class="qm" viewBox="0 0 56 40" fill="currentColor" aria-hidden="true"
            style="height:28px;width:auto;color:var(--color-terracotta-500)">
            <path d="M9.24 0H24.4L15.16 40H0L9.24 0Z" />
            <path d="M40.84 0H56L46.76 40H31.6L40.84 0Z" />
          </svg>

          <blockquote class="mt-4">
            <p class="text-[1.0625rem] leading-relaxed text-black">{t.quote}</p>
          </blockquote>

          <figcaption class="mt-6 flex items-center gap-3.5 border-t border-black/10 pt-5">
            <span
              class:list={[
                'grid h-11 w-11 shrink-0 place-items-center rounded-brand font-title text-sm font-bold',
                t.half === 'ugynokseg' ? 'bg-blue-800 text-paper' : 'bg-terracotta-500 text-black',
              ]}
              aria-hidden="true"
            >{t.initials}</span>
            <span class="min-w-0">
              <span class="block font-title text-[0.9375rem] font-bold text-black">
                {t.name}
              </span>
              <span class="block truncate text-sm text-black/65">
                {t.role} · {t.company}
              </span>
            </span>
            <!-- The half chip used to be terracotta whatever it said, so an
                 agency testimonial was badged in the coaching colour. -->
            <span
              class:list={[
                'ml-auto hidden shrink-0 bm-tag sm:inline-block',
                t.half === 'ugynokseg' ? 'bm-tag--agency' : 'bm-tag--coaching',
              ]}
            >{(t.track ?? HALF_LABEL[t.half]).toUpperCase()}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {PROOF_IS_PLACEHOLDER && (
      <p class="mt-2 rounded-brand bg-terracotta-200 px-4 py-3 text-sm text-terracotta-800">
        <strong>Fejlesztői megjegyzés (élesítés előtt törlendő):</strong> ezek kitalált
        vélemények, a tördelés bemutatására. Valós, engedélyezett véleményekre cserélendők a
        <code class="font-mono">src/data/proof.ts</code> fájlban.
      </p>
    )}
  </div>
</section>
