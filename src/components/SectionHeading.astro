---
interface Props {
  /** Authored in UPPERCASE — never text-transform, so Ő and Ű keep their acutes. */
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  /** Long leads read badly centred — six centred lines have no stable left
   *  edge for the eye to return to. Set this to 'left' to centre the title
   *  but keep the paragraph ranged left inside the same centred column. */
  leadAlign?: 'left' | 'center';
  /** true when sitting on blue-800 or black: type becomes paper. */
  onDark?: boolean;
  class?: string;
}
const {
  eyebrow, title, lead, align = 'left', leadAlign, onDark = false,
  class: className = '',
} = Astro.props;
const leadAlignment = leadAlign ?? align;
---
<div class:list={['max-w-[52rem]', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && (
    <p class:list={['t-label', onDark ? 'text-terracotta-200' : 'text-terracotta-800']}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={['t-title', eyebrow && 'mt-4', onDark ? 'text-paper' : 'text-black']}>
    <Fragment set:html={title} />
  </h2>
  {lead && (
    <p
      class:list={[
        't-lead mt-6 max-w-[56ch]',
        onDark ? 'text-paper/85' : 'text-black/80',
        align === 'center' && 'mx-auto',
        leadAlignment === 'left' && 'text-left',
      ]}
    ><Fragment set:html={lead} /></p>
  )}
</div>
