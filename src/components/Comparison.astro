---
import SectionHeading from '@/components/SectionHeading.astro';

/**
 * The Brandműhely column was blue-800 with white type. Two things wrong with
 * that under Round 6: blue is the AGENCY half, so the coaching offer was
 * filed under the wrong one; and on a shared ground the brand marks a
 * coaching item with terracotta. It is now terracotta-500 carrying black
 * (5.19:1) — a fill, which is the only thing a 500 step may ever be.
 */

const rows = [
  { label: 'Teljesítmény', agency: 'Mástól függsz', course: 'Túl általános tudás', us: '100% egyénre szabva' },
  { label: 'Tulajdonjog', agency: 'Gyakran vitás', course: 'A tiéd', us: 'A tiéd, örökre' },
  { label: 'Megbízhatóság', agency: 'Napok, mire válaszol', course: 'Nincs kitől kérdezni', us: 'Azonnal tudsz kérdezni' },
  { label: 'Te vagy a központban?', agency: 'Részben, + más cégek', course: 'Nem, általános', us: 'Igen, kizárólag' },
  { label: 'Havi díj', agency: '150–400 e Ft havonta', course: 'Havi előfizetés 20–30 e Ft', us: 'Nincs havidíj. Egyszer fizetsz a tudásért' },
  { label: 'Elégedettség', agency: 'Változó', course: 'Alacsony', us: '200+ pozitív visszajelzés' },
];

const cols = [
  { key: 'agency', title: 'Marketinges', sub: 'Kiszervezed' },
  { key: 'course', title: 'Csoportos tanfolyam', sub: 'Videókat nézel' },
  { key: 'us', title: 'Egyéni oktatás', sub: 'Megcsinálod, vezetéssel' },
] as const;
---

<section class="section" data-theme="shared">
  <div class="container-x">
    <SectionHeading
      title="Három lehetőséged van, nem mindegy mit választasz!"
      lead="Az egyéni oktatás neked szól, ha a marketingesekben már nem bízol, és a csoportos tanfolyamok alatt rájöttél, hogy az nem neked való."
      align="center"
      leadAlign="left"
    />

    <!-- Desktop: comparison table -->
    <div class="mt-14 hidden overflow-hidden card lg:block">
      <table class="w-full text-left">
        <caption class="sr-only">
          Marketinges, csoportos tanfolyam és egyéni oktatás összehasonlítása
        </caption>
        <thead>
          <tr class="border-b border-black/10">
            <th scope="col" class="w-[22%] px-6 py-5"><span class="sr-only">Szempont</span></th>
            {cols.map((c) => (
              <th
                scope="col"
                class:list={[
                  'px-6 py-5 align-bottom',
                  c.key === 'us' && 'bg-terracotta-500',
                ]}
              >
                <span
                  class:list={[
                    'block font-title text-lg font-bold tracking-tight',
                    'text-black',
                  ]}
                >{c.title}</span>
                <span
                  class:list={[
                    'mt-1 block text-sm font-normal',
                    c.key === 'us' ? 'text-black/75' : 'text-black/65',
                  ]}
                >{c.sub}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class:list={[i % 2 === 1 && 'bg-paper/60']}>
              <th scope="row" class="px-6 py-4 text-sm font-semibold text-black">{r.label}</th>
              <td class="px-6 py-4 text-sm text-black/65">{r.agency}</td>
              <td class="px-6 py-4 text-sm text-black/65">{r.course}</td>
              <td class="bg-terracotta-500 px-6 py-4 text-sm font-medium text-black">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile: stacked cards. A 4-column table is unreadable on a phone, and
         most ad traffic lands here. -->
    <div class="mt-12 space-y-4 lg:hidden">
      {rows.map((r) => (
        <div class="overflow-hidden card">
          <p class="border-b border-black/10 bg-paper px-4 py-3 font-title text-sm font-bold text-black">
            {r.label}
          </p>
          <dl class="divide-y divide-black/10">
            <div class="flex items-start justify-between gap-4 px-4 py-3">
              <dt class="text-sm text-black/65">Marketinges</dt>
              <dd class="text-right text-sm text-black/72">{r.agency}</dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3">
              <dt class="text-sm text-black/65">Csoportos tanfolyam</dt>
              <dd class="text-right text-sm text-black/72">{r.course}</dd>
            </div>
            <div class="flex items-start justify-between gap-4 bg-terracotta-500 px-4 py-3">
              <dt class="text-sm font-semibold text-black/75">Egyéni oktatás</dt>
              <dd class="text-right text-sm font-medium text-black">{r.us}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>
