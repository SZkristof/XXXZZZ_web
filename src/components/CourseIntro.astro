---
import Button from '@/components/Button.astro';
import { contact } from '@/data/site';

/**
 * No eyebrow here, by request: this is the page's central argument, and a
 * 12px label above it would frame it as just another section. The client's
 * paragraph is long, so it is broken at its own sentence boundaries into
 * three beats — the words are unchanged — and the three hard facts inside it
 * are pulled out as a strip, because a fact buried in the fifth sentence of a
 * paragraph is a fact nobody reads.
 *
 * Coaching mode: this is the training pitch, and Round 6 ties colour to the
 * half. Type on terracotta is BLACK (5.19:1) — never paper, never blue at
 * any size. The secondary button is the white `light` variant, because the
 * action role here is blue-800 and a second blue fill would compete.
 */
const facts = [
  { k: 'Időigény', v: 'kb. 5 óra egy felület' },
  { k: 'Mikor', v: 'hétköznap vagy hétvégén' },
  { k: 'Előképzettség', v: 'nem szükséges' },
];
---

<section class="section" data-theme="coaching" id="oktatas">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="t-title">Hirdetéskezelés egyéni oktatás</h2>

        <dl class="mt-8 space-y-4 border-t border-black/20 pt-8">
          {facts.map((f) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="t-label t-eyebrow">{f.k.toUpperCase()}</dt>
              <dd class="t-body text-right font-medium">{f.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-9 hidden lg:block">
          <Button href="/kepzes" size="lg" variant="light" track="course-intro">
            Az oktatásról bővebben
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </Button>
        </div>
      </div>

      <div>
        <p class="t-lead">
          Eleged van abból, hogy nem mennek a hirdetéseid és csak égeted a pénzt?
          Ha nem tudod, hogyan kezdj hozzá, akkor az oktatásom pont Neked szól.
        </p>

        <p class="t-body mt-6 text-black/80">
          Megfelelő tudással vértezlek fel, hogy könnyedén boldogulj a
          <strong class="font-semibold text-black">Facebook, Instagram (Meta) vagy Google
          hirdetéskezelő felületén</strong>, és magabiztosan tudj kampányokat létrehozni a
          megfelelő célközönségnek. Az oktatás a
          <strong class="font-semibold text-black">saját tempód szerint</strong> zajlik,
          hétköznap vagy hétvégén:
          <strong class="font-semibold text-black">csupán 5 órát</strong> vesz igénybe egy
          felület elsajátítása, és nem igényel előképzettséget — de természetesen ha van,
          az sem baj.
        </p>

        <p class="t-body mt-6 text-black/80">
          Azonnali tudást kapsz, ahol nem csak általános sallangot hallasz a hirdetésekről,
          hanem közösen alkotunk, hogy felépítsük a digitális marketinged.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row lg:hidden">
          <Button href="/kepzes" size="lg" variant="light" track="course-intro-mobile">
            Az oktatásról bővebben
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </Button>
        </div>

        <p class="t-small mt-6 text-black/75">
          Nem tudod, mi lenne számodra a megfelelő? Hívj: <a href={`tel:${contact.phoneHref}`}
            class="font-medium underline underline-offset-4">{contact.phone}</a>
        </p>
      </div>
    </div>
  </div>
</section>
