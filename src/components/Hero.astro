---
import Button from '@/components/Button.astro';
import { expert, brands, brandsReassurance } from '@/data/site';
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <!-- Ambient glow + grid. Pure CSS: no image weight on the LCP screen. -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full
             bg-[radial-gradient(circle,rgba(255,90,31,0.22),transparent_62%)] blur-2xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.16]
             [background-image:linear-gradient(to_right,rgba(255,255,255,0.09)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.09)_1px,transparent_1px)]
             [background-size:64px_64px]
             [mask-image:radial-gradient(ellipse_75%_55%_at_50%_0%,#000,transparent)]"
    >
    </div>
  </div>

  <div class="container-x relative">
    <div class="grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:py-28">
      <!-- Copy -->
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5
                 text-xs font-semibold tracking-wide text-ember-200 ring-1 ring-inset ring-white/15"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ember-400 opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-ember-400"></span>
          </span>
          1 az 1-ben hirdetési képzés · online
        </p>

        <h1 class="mt-6 max-w-[15ch] text-5xl font-extrabold text-white">
          A saját hirdetéseidet építed.
          <span class="relative inline-block">
            <span class="relative z-10 text-ember-400">Csak nem egyedül.</span>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
          60 perces, személyes online alkalmak Meta, Google és LinkedIn hirdetésekről.
          A <strong class="font-semibold text-white">te fiókodban</strong>, a te termékeiden,
          a te kereteddel dolgozunk — {expert.yearsExperience} év ügynökségi tapasztalattal
          a hátad mögött.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href="/kapcsolat" size="lg" track="hero-primary" class="sm:flex-none">
            Ingyenes 30 perces konzultáció
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="transition-transform duration-300 ease-out group-hover:translate-x-1">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </Button>
          <Button href="/arak" size="lg" variant="onDark" track="hero-secondary">
            Megnézem az árakat
          </Button>
        </div>

        <p class="mt-4 text-sm text-ink-400">
          Nem kell rá készülnöd, és nem lesz belőle értékesítési hívás.
        </p>
      </div>

      <!-- Visual: portrait slot + a live-feeling metric card -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-2xl
                 bg-gradient-to-br from-ink-800 to-ink-900 ring-1 ring-inset ring-white/10"
        >
          <!-- Monogram watermark: keeps the frame looking intentional until the
               real portrait lands. Sits under the photo, so it needs no removal. -->
          <span
            class="pointer-events-none absolute inset-0 grid place-items-center
                   font-display text-[13rem] font-extrabold leading-none text-white/[0.04]"
            aria-hidden="true">B</span
          >

          <!-- TODO: csere Kristóf portréjára (1200×1500, WebP) -->
          <img
            src="/img/kristof-portrait.jpg"
            alt={`${expert.name}, paid media szakértő`}
            width="1200"
            height="1500"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative h-full w-full object-cover object-top"
            onerror="this.remove()"
          />
          <div
            class="pointer-events-none absolute inset-0
                   bg-gradient-to-t from-ink-950 via-ink-950/25 to-transparent"
          >
          </div>
          <!-- Caption sits right of centre so the metric card never covers it. -->
          <div class="absolute inset-x-0 bottom-0 p-6 pl-[42%]">
            <p class="font-display text-lg font-bold leading-tight text-white">{expert.name}</p>
            <p class="mt-1 text-sm leading-snug text-ink-300">{expert.role}</p>
          </div>
        </div>

        <!-- Floating proof card -->
        <div
          class="absolute bottom-5 -left-3 w-[14.5rem] rounded-xl border border-ink-100
                 bg-white p-4 shadow-pop sm:-left-6"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
            Átlagos ROAS
          </p>
          <div class="mt-1.5 flex items-baseline gap-2">
            <span class="font-display text-2xl font-extrabold text-ink-950">1,8×</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              class="text-ink-400">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="font-display text-2xl font-extrabold text-signal-600">4,3×</span>
          </div>
          <p class="mt-1 text-xs text-ink-500">9 hét alatt · webshop, 6 fő</p>
          <!-- TODO: cserélni valós ügyféladatra -->
        </div>
      </div>
    </div>

    <!-- Brand strip. The reassurance line is deliberately attached: these logos
         impress, but to a 5-person company they also whisper "too expensive". -->
    <div class="border-t border-white/10 py-9">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:gap-10">
        <p class="eyebrow shrink-0 text-ink-500">Dolgoztam velük</p>
        <ul class="flex flex-wrap items-center gap-x-7 gap-y-3">
          {brands.map((b) => (
            <li class="font-display text-base font-bold tracking-tight text-ink-400
                       transition-colors duration-300 hover:text-white sm:text-lg">
              {b}
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-400">
        <span class="font-semibold text-ember-300">{brandsReassurance}</span>
        {' '}Ugyanaz a szakmai tudás, csak a te méretedre szabva.
      </p>
    </div>
  </div>
</section>
