---
import Button from '@/components/Button.astro';
import { expert, brands, brandsReassurance } from '@/data/site';

/**
 * Paper ground, flat. The brand system has one ambient shade and no gradients
 * or glows — depth exists only to make a white card legible against paper
 * (1.12:1), never for its own sake.
 */
---

<section class="ground-paper">
  <div class="container-x">
    <div class="grid items-center gap-8 py-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12 lg:py-16">
      <div>
        <!-- Authored uppercase, never text-transform: that is what protects Ő and Ű. -->
        <p class="t-label text-terracotta-800">1 AZ 1-BEN HIRDETÉSI KÉPZÉS · ONLINE</p>

        <h1 class="t-display mt-6 max-w-[16ch] text-black">
          A saját hirdetéseidet építed. Csak nem egyedül.
        </h1>

        <p class="t-lead mt-6 max-w-[46ch] text-black/80">
          60 perces, személyes online alkalmak Meta, Google és LinkedIn hirdetésekről.
          A te fiókodban, a te termékeiden, a te kereteddel dolgozunk.
        </p>

        <p class="t-body mt-4 max-w-[46ch] text-black/72">
          {expert.yearsExperience} év ügynökségi tapasztalat — de a te méretedre szabva.
        </p>

        <div class="mt-12 flex flex-col gap-3 sm:flex-row">
          <Button href="/kapcsolat" size="lg" track="hero-primary">
            Ingyenes 30 perces konzultáció
          </Button>
          <Button href="/arak" size="lg" variant="outline" track="hero-secondary">
            Megnézem az árakat
          </Button>
        </div>

        <p class="t-small mt-4 text-black/65">
          Nem kell rá készülnöd, és nem lesz belőle értékesítési hívás.
        </p>
      </div>

      <!-- Portrait: cropped at radius, lifted with the one step-up shade. -->
      <div class="mx-auto w-full max-w-[420px] lg:max-w-none">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-brand bg-blue-800 shadow-shade-lift"
        >
          <!-- Monogram stand-in until the real portrait lands. -->
          <span
            class="pointer-events-none absolute inset-0 grid place-items-center text-paper/10"
            aria-hidden="true"
          >
            <svg width="45%" viewBox="0 0 64 64" style="fill:currentColor">
              <polygon points="8,8 24.21,8 13.13,56 8,56" />
              <polygon points="32.21,8 42.87,8 31.79,56 21.13,56" />
              <polygon points="50.87,8 56,8 56,56 39.79,56" />
            </svg>
          </span>

          <picture>
            <source srcset="/img/kristof-portrait.webp" type="image/webp" />
            <img
              src="/img/kristof-portrait.jpg"
              alt={`${expert.name}, paid media szakértő`}
              width="900" height="1125" loading="eager" fetchpriority="high" decoding="async"
              class="relative h-full w-full object-cover object-top"
            />
          </picture>
          <div class="absolute inset-x-0 bottom-0 bg-black/55 p-4">
            <p class="t-subtitle text-paper">{expert.name}</p>
            <p class="t-small mt-1 text-paper/80">{expert.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Brand strip on a terracotta block: a colour section commits, and the
       reassurance line rides with the logos so they never read as "too big
       for me" to a five-person company. Type on terracotta is BLACK. -->
  <div class="ground-terracotta">
    <div class="container-x py-16">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-12">
        <p class="t-label shrink-0 text-black/70">DOLGOZTAM VELÜK</p>
        <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
          {brands.map((b) => (
            <li class="t-subtitle text-black">{b}</li>
          ))}
        </ul>
      </div>
      <p class="t-body mt-6 max-w-[62ch] text-black">
        <strong class="font-semibold">{brandsReassurance}</strong>
        {' '}Ugyanaz a szakmai tudás, csak a te méretedre szabva.
      </p>
    </div>
  </div>
</section>
