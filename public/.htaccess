# Apache/LiteSpeed configuration for Rackhost shared hosting.
# Astro emits a static site, so this handles HTTPS, caching and security only.

# ---------------------------------------------------------------- HTTPS ----
<IfModule mod_rewrite.c>
RewriteEngine On

  # Canonical host: the BARE brandmuhely.hu, and everything else 301s to it,
  # keeping its path so deep links survive.
  #
  #   www.brandmuhely.hu         — http://www used to take two hops, one to
  #                                add TLS and another to drop the www; this
  #                                rule runs first and does both at once.
  #   xn--brandmhely-6fc.hu      — brandműhely.hu in Punycode, which is how
  #                                the accented domain reaches the server.
  #                                Kristóf registered it defensively; nobody
  #                                types ű into an address bar, so it is a
  #                                redirect and never a second site. This is
  #                                inert until the domain is pointed at this
  #                                hosting account — it can only fire on a
  #                                host that actually arrives here.
  #
  # Deliberately NOT a catch-all "anything that is not brandmuhely.hu". A
  # staging host would be caught by that and redirected to production, which
  # is exactly how a preview environment silently stops working.
  RewriteCond %{HTTP_HOST} ^www\.brandmuhely\.hu$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^(www\.)?xn--brandmhely-6fc\.hu$ [NC]
  RewriteRule ^(.*)$ https://brandmuhely.hu/$1 [R=301,L]

  # Force HTTPS (Rackhost provides free Let's Encrypt — enable it first).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- Renamed 2026-09: /kepzes -> /oktatas --------------------------------
  # The training pages moved under a name that matches what people search for
  # ("facebook hirdetés egyéni oktatás"), and each platform got its own page.
  # 301, not 302: the move is permanent, and only a 301 passes on the ranking
  # the old URL earned. Placed after the HTTPS and canonical-host rules so a
  # visitor on the old URL is not redirected twice.
  RewriteRule ^kepzes/?$ /oktatas/ [R=301,L]
  RewriteRule ^kepzes/(.*)$ /oktatas/$1 [R=301,L]

  # ---- Renamed 2026-10: /ugynokseg -> /hirdeteskezeles ---------------------
  # "Ügynökség" is what the business calls itself; "hirdetéskezelés" is what
  # people type into Google, and it is already the word the page, the nav and
  # the H1 use. Same reasoning as /kepzes -> /oktatas above, and the same 301:
  # the move is permanent, and only a 301 carries the ranking over.
  RewriteRule ^ugynokseg/?$ /hirdeteskezeles/ [R=301,L]

  # Serve /about as /about/index.html without exposing the filename.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# --- Régi WordPress URL-ek --------------------------------------------------
# A domain alatt korábban egy WordPress LMS-sablon futott, és annak a DEMO
# TARTALMA van még a Google indexében: angol nyelvű cikkek egyetemi
# felvételiről és online oktatásról, a Tutor LMS sablonoldalai
# (tut-course-grid-03, home-coursera-tutor, 4-columns), kurzus- és
# eseményarchívumok. Egyik sem Kristóf tartalma, és egyikhez sincs megfelelő
# oldal az új site-on.
#
# EZÉRT 410, NEM 301. Egy 301 akkor helyes, ha a tartalom MÁSHOVÁ KÖLTÖZÖTT.
# Ha nincs megfelelője, és mindet a főoldalra irányítanánk, a Google azt
# "soft 404"-ként kezeli: nem ad át értéket, viszont elfedi, hogy ezek a
# címek valójában megszűntek. A 410 azt mondja, hogy végleg nincs többé —
# és a Google a 410-et érezhetően gyorsabban dobja ki az indexből, mint a
# 404-et.
#
# A minták szándékosan az egykori sablon útvonalaira szűkítenek. Az új oldal
# útvonalai (/oktatas/, /hirdeteskezeles/, /arak/, /rolam/, /eredmenyek/,
# /kapcsolat/, /blog/) egyikkel sem ütköznek.
<IfModule mod_rewrite.c>
  # A WordPress szokásos végpontjai.
  RewriteRule ^wp-admin(/.*)?$ - [R=410,L]
  RewriteRule ^wp-login\.php$ - [R=410,L]
  RewriteRule ^xmlrpc\.php$ - [R=410,L]
  RewriteRule ^wp-(content|includes|json)(/.*)?$ - [R=410,L]

  # A sablon tartalomtípusai és archívumai.
  RewriteRule ^(events?|courses|course-category|course-tag|zoom-meetings|category|tag|author)(/.*)?$ - [R=410,L]

  # Dátumarchívumok: /2024/, /2024/04/ és hasonlók.
  RewriteRule ^(19|20)[0-9]{2}(/[0-9]{2})?(/[0-9]{2})?/?$ - [R=410,L]

  # A sablon saját demo-oldalai.
  RewriteRule ^(tut-|home-).*$ - [R=410,L]
  RewriteRule ^(4-columns|dashboard-2|hello-vilag)/?$ - [R=410,L]

  # A demo blogbejegyzések, amik a gyökérben ülnek.
  RewriteRule ^(how-blockchain-can-disrupt-university-admissions|how-technology-is-transforming-modern-education|how-digital-platforms-are-shaping-business-schools|why-business-students-need-tech-skills-for-the-future|common-university-admission-mistakes-and-solutions)/?.*$ - [R=410,L]

  # WordPress RSS-végpontok bárhol.
  RewriteRule (^|/)feed/?$ - [R=410,L]
</IfModule>

# -------------------------------------------------------------- caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed filenames — safe to cache forever.
  <FilesMatch "\.(woff2|css|js)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  # HTML must revalidate so content changes go live immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------ compression --
# REMOVED. Rackhost already compresses responses, and adding a second DEFLATE
# layer produced a double-encoded body that Chrome could not decode — which it
# surfaces by offering the page as a download instead of rendering it. The
# hosting-level compression is sufficient; re-adding this gains nothing and
# risks the same failure.

# -------------------------------------------------------------- security ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # woff2 is fetched with crossorigin because of the preload hints.
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Never serve the lead CSV or local config, whatever the directory layout.
<FilesMatch "^(config\.local\.php|leads\.csv)$">
  Require all denied
</FilesMatch>

Options -Indexes
